#!/usr/bin/env bash
# A vim-shaped remote for the Apple TV. hjkl is the D-pad, and the rest
# follows: Enter selects, m is back (menu), H is home, space toggles
# play/pause, - and = are volume, < and > skip, ? redraws the keymap,
# q quits.
#
# One atvremote REPL holds the Companion connection open for the whole
# session and reads commands from a FIFO, so a keypress is a write to a
# pipe — instant — rather than a fresh handshake per button.
#
# Pairings come from ./connect apple-tv, which records "id name" lines in
# the registry below. With several TVs paired, pass a name fragment
# (apple-tv-remote patio) or pick from the list it prints.
set -euo pipefail

registry="$HOME/.config/orchard/apple-tvs"

if [ ! -s "$registry" ]; then
    echo "No Apple TV is paired with this machine yet. Run: ./connect apple-tv" >&2
    exit 1
fi

pick_device() {
    local wanted="${1:-}"
    if [ -n "$wanted" ]; then
        grep -i -- "$wanted" "$registry" | head -1 && return 0
        echo "No paired Apple TV matches '$wanted'. Paired:" >&2
        cat "$registry" >&2
        return 1
    fi
    if [ "$(wc -l < "$registry")" -eq 1 ]; then
        head -1 "$registry"
        return 0
    fi
    echo "Which Apple TV?" >&2
    local i=1 line
    while IFS= read -r line; do
        echo "  $i) ${line#* }" >&2
        i=$((i + 1))
    done < "$registry"
    local choice
    read -rp "> " choice </dev/tty
    sed -n "${choice}p" "$registry"
}

device="$(pick_device "${1:-}")" || exit 1
device_id="${device%% *}"
device_name="${device#* }"

show_keymap() {
    printf '\033[2J\033[H'
    echo "── $device_name ─────────────────────────"
    echo "  h j k l   navigate        Enter  select"
    echo "  m         back (menu)     H      home"
    echo "  space     play / pause    - =    volume"
    echo "  < >       previous/next   q      quit"
    echo "──────────────────────────────────────────"
}

command_fifo="$(mktemp -u)"
mkfifo -m 600 "$command_fifo"

cleanup() {
    exec 3>&- 2>/dev/null || true
    rm -f "$command_fifo"
    stty sane 2>/dev/null || true
}
trap cleanup EXIT

"$HOME/.local/bin/atvremote" --id "$device_id" cli < "$command_fifo" >/dev/null 2>&1 &
exec 3> "$command_fifo"

press() { printf '%s\n' "$1" >&3; }

show_keymap
stty -echo -icanon
while IFS= read -rsn1 key; do
    if [ "$key" = $'\x1b' ]; then
        read -rsn2 -t 0.05 key || { key=$'\x1b'; }
    fi
    case "$key" in
        h|'[D') press left ;;
        j|'[B') press down ;;
        k|'[A') press up ;;
        l|'[C') press right ;;
        ''|$'\n') press select ;;
        ' ') press play_pause ;;
        m) press menu ;;
        H) press home ;;
        -) press volume_down ;;
        =|+) press volume_up ;;
        '<') press previous ;;
        '>') press next ;;
        '?') show_keymap ;;
        q) break ;;
    esac
done
