#!/usr/bin/env bash
# Show the on-screen square for a level change: given a 0.0-1.0 fraction and a
# glyph name, push them into the eww OSD window and open it, then close it after
# a beat. The glyph is a GTK symbolic icon name — eww hands it to GTK, which
# rasterises it at the display scale (crisp on HiDPI) and recolours it to the
# theme via the CSS in eww.scss.
#
# Usage: osd <fraction> <glyph>
#   e.g. osd 0.65 volume-high
set -euo pipefail

fraction=$1
glyph=$2
percent=$(awk -v v="$fraction" 'BEGIN { printf "%d", v * 100 }')

case "$glyph" in
  volume-high)         icon=audio-volume-high-symbolic ;;
  volume-medium)       icon=audio-volume-medium-symbolic ;;
  volume-low)          icon=audio-volume-low-symbolic ;;
  volume-muted)        icon=audio-volume-muted-symbolic ;;
  screen-brightness)   icon=display-brightness-symbolic ;;
  keyboard-brightness) icon=keyboard-brightness-symbolic ;;
  *)                   icon=$glyph ;;
esac

# A wedged eww daemon draws the square and then stops answering — the window
# stays lit and nothing can close it. So before drawing, check the daemon is
# responsive, and if opening still hangs, restart it (which clears the stuck
# square) and draw on the fresh one. Every path is time-bounded so a wedge can
# never leave this script hanging.
daemon_answers()   { timeout 1 eww ping >/dev/null 2>&1; }
push_level()       { timeout 1 eww update osd_icon="$icon" osd_level="$percent" >/dev/null 2>&1; }
raise_square()     { timeout 1 eww open osd >/dev/null 2>&1; }

daemon_answers || "$HOME/.local/bin/restart-osd"
push_level || true
if ! raise_square; then
  "$HOME/.local/bin/restart-osd"
  push_level || true
  raise_square || true
fi

# Close after 1.2s, but only if no newer change has come in. Holding a key fires
# this many times a second; each writes a fresh token and the stale closers bow
# out, so the square stays up while you're adjusting and dismisses once you stop.
token=$(date +%s%N)
echo "$token" > /tmp/orchard-osd.token
square_still_painted() { hyprctl layers 2>/dev/null | grep -q "namespace: eww-osd"; }
still_owns_screen()    { [ "$(cat /tmp/orchard-osd.token 2>/dev/null)" = "$token" ]; }

( sleep 1.2
  if still_owns_screen; then
    # The close's exit code only reports the daemon's window registry, and the
    # registry can be wrong in both directions: it can refuse ("no such
    # window", or a timeout) while the square is visibly up, or agree while a
    # stranded surface stays painted. The compositor is the ground truth, so
    # after closing ask Hyprland whether an eww-osd layer is still on screen
    # and restart the daemon if so — unless a newer change has taken over the
    # square in the meantime, in which case the layer is legitimately alive
    # and its own closer will handle it.
    timeout 1 eww close osd >/dev/null 2>&1 || "$HOME/.local/bin/restart-osd"
    sleep 0.4
    if still_owns_screen && square_still_painted; then
      "$HOME/.local/bin/restart-osd"
    fi
  fi
) & disown 2>/dev/null || true
