#!/bin/sh
# Prints the installed packages whose names belong to a different app in
# the AUR, as the comma-separated list yay's --ignore takes.
#
# Hype and Folio are built from Omarchy's recipes (see the presentations
# and folio features). The AUR's `hype` is a Twitch clip finder and its
# `folio` a GNOME notes app, both with higher version numbers, so yay
# would otherwise count them as upgrades and install them over the real
# ones.
echo hype,folio
