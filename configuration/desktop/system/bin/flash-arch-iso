#!/usr/bin/env bash
# Download the current Arch ISO, verify Arch's signature on it, and write it
# to a USB stick — the "make install media" step of bringing up a new
# machine. Everything it uses (curl, lsblk, dd, pacman-key) is on the base
# system; the pacman keyring already trusts Arch's release signing key, so
# the signature check costs nothing and catches a corrupted or tampered
# download before it becomes a boot drive.
#
# The mirror is Arch's own geo-routed one, so it picks a nearby official
# mirror by itself, and iso/latest/ tracks each monthly release. The
# checksum comparison before downloading is what keeps the cached copy
# honest across releases — without it a complete old ISO in the cache
# would be flashed forever. Freshness comes from the checksum; trust
# comes from the signature.
set -euo pipefail

mirror=https://geo.mirror.pkgbuild.com/iso/latest
iso_name=archlinux-x86_64.iso
download_directory="$HOME/.cache/arch-iso"
iso="$download_directory/$iso_name"

current_release_sha256() {
  curl -fsL "$mirror/sha256sums.txt" | awk -v name="$iso_name" '$2 == name {print $1}'
}

cached_iso_is_current_release() {
  [ -f "$iso" ] && printf '%s  %s\n' "$1" "$iso" | sha256sum -c --status
}

download_current_iso() {
  mkdir -p "$download_directory"

  local release_sha256
  release_sha256="$(current_release_sha256)"
  [ -n "$release_sha256" ] || { echo "Couldn't read the current release checksum from $mirror." >&2; exit 1; }

  if cached_iso_is_current_release "$release_sha256"; then
    echo "Cached ISO is the current release; skipping download."
    return 0
  fi

  rm -f "$iso" "$iso.sig"
  echo "Downloading $iso_name..."
  curl -fL -o "$iso" "$mirror/$iso_name"
  curl -fsL -o "$iso.sig" "$mirror/$iso_name.sig"
}

verify_iso_signature() {
  echo "Verifying Arch's signature..."
  sudo pacman-key --verify "$iso.sig"
}

pick_usb_stick() {
  mapfile -t sticks < <(lsblk -d -p -n -o NAME,TRAN | awk '$2 == "usb" {print $1}')

  if [ "${#sticks[@]}" -eq 0 ]; then
    echo "No USB drive found. Plug the stick in and rerun." >&2
    exit 1
  fi

  if [ "${#sticks[@]}" -eq 1 ]; then
    TARGET="${sticks[0]}"
  else
    echo
    echo "Pick the USB stick by index:"
    for i in "${!sticks[@]}"; do
      echo "  $i: ${sticks[$i]}  $(lsblk -d -n -o SIZE,MODEL "${sticks[$i]}")"
    done
    read -rp "Index: " index
    TARGET="${sticks[$index]}"
  fi

  echo
  echo "=========================================================="
  echo "  WILL WIPE AND FLASH: $TARGET"
  echo "  $(lsblk -d -n -o SIZE,MODEL "$TARGET")"
  echo "  Every byte on this device will be destroyed."
  echo "=========================================================="
  read -rp "Type 'yes' to continue: " confirm
  [ "$confirm" = "yes" ] || { echo "Aborted."; exit 1; }
}

unmount_stick_partitions() {
  local partition
  for partition in "$TARGET"?*; do
    findmnt -n "$partition" >/dev/null 2>&1 && sudo umount "$partition"
  done
  return 0
}

write_iso_to_stick() {
  sudo dd if="$iso" of="$TARGET" bs=4M oflag=direct conv=fsync status=progress
  sync
  echo
  echo "Done. Boot the new machine with the stick in, press F2 for BIOS"
  echo "(secure boot off, USB first in boot order), and follow the"
  echo "manual's install chapter."
}

# Arch removes the old kernel's module tree when it upgrades the kernel, so
# after an update the running kernel can't load anything not already loaded
# — including the USB storage driver this needs. Without this check that
# surfaces as a baffling "No USB drive found" with the stick plugged in.
require_loadable_kernel_modules() {
  [ -d "/lib/modules/$(uname -r)" ] && return 0
  echo "The kernel was upgraded since boot (running $(uname -r); installed $(ls /lib/modules | tail -1))." >&2
  echo "The USB storage driver can't load until you reboot. Reboot and rerun." >&2
  exit 1
}

require_loadable_kernel_modules
download_current_iso
verify_iso_signature
pick_usb_stick
unmount_stick_partitions
write_iso_to_stick
