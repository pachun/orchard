#!/bin/sh
# Pick a wifi network via the Frappé-themed fuzzel picker. Connects with
# saved credentials if available; falls back to a fuzzel password prompt
# for secured networks. Open networks skip the password prompt entirely.
# Triggered from waybar's network module on-click.
#
# Row format (proportional font — no fixed columns, just consistent shape):
#   <signal-icon>  <SSID>  <lock-if-secured>  <dot-if-active>
# One row per network. nmcli lists an entry per access point, so a mesh
# repeats an SSID once per node; those are collapsed, keeping the strongest
# signal. There is no band column: connecting takes an SSID and nothing else,
# so a 2.4G row and a 5G row for one network did the same thing.
# Special actions get their own icon so they read as actions, not networks:
#   <arrows-clockwise>  Refresh
#   <link-break>        Disconnect
#
# Phosphor codepoints:
#   wifi-high     U+E4EA   wifi-medium    U+E4EE
#   wifi-low      U+E4EC   wifi-none      U+E4F0
#   lock-simple   U+E308   arrows-clockwise U+E094
#   link-break    U+E2E4
# Active marker uses U+25CF (●) — small and reads clearly at end of row.
#
# Toggle behavior is shared with the other fuzzel menus — see
# _fuzzel-menu-toggle for the protocol.
set -eu

. "$HOME/.local/bin/_fuzzel-menu-toggle"

SIG_HIGH=''
SIG_MED=''
SIG_LOW=''
SIG_NONE=''
LOCK=''
ACTIVE_DOT='●'
ICON_RESCAN=''
ICON_DISCONNECT=''

DISCONNECT_LABEL="$ICON_DISCONNECT  Disconnect"
RESCAN_LABEL="$ICON_RESCAN  Refresh"

# waybar-wifi-status renders a spinner while this file exists. The trap
# guarantees it's cleared even if the script is killed mid-connect, so
# we don't strand the spinner on the bar.
spinner_on() {
    touch /tmp/wifi-connecting
    pkill -RTMIN+8 waybar 2>/dev/null || true
}
spinner_off() {
    rm -f /tmp/wifi-connecting
    pkill -RTMIN+8 waybar 2>/dev/null || true
}
trap spinner_off EXIT INT TERM

# Whether the *next* listing should pay for a scan. Off by default; the
# Refresh row turns it on for one pass.
rescan=no

while :; do
    active_wifi=$(nmcli -t -f NAME,TYPE connection show --active \
                  | awk -F: '$2=="802-11-wireless"{print $1; exit}')

    # --rescan no is the whole reason this menu opens instantly. `nmcli device
    # wifi list` defaults to --rescan auto, which triggers a full blocking scan
    # whenever its cache is more than 30 seconds old — i.e. essentially every
    # time you actually open the menu. Measured at 4.3 seconds cold, against
    # 21ms off the cache. A picker you summoned with a keystroke cannot spend
    # four seconds deciding whether to appear.
    #
    # NetworkManager scans on its own schedule anyway, so the cache is rarely
    # far behind, and the background kick below keeps the *next* open fresh.
    # When you genuinely want current data, Refresh asks for it and then it's
    # fair to make you wait.
    networks=$(nmcli -t -f IN-USE,SSID,SECURITY,SIGNAL device wifi list --rescan "$rescan" \
        | awk -F: -v sig_high="$SIG_HIGH" -v sig_med="$SIG_MED" \
                  -v sig_low="$SIG_LOW"   -v sig_none="$SIG_NONE" \
                  -v lock="$LOCK"         -v dot="$ACTIVE_DOT" '
            # One row per network, not one per radio.
            #
            # nmcli lists an entry per *access point*, so a mesh answers with
            # the same SSID over and over — a house with six of them buried the
            # rest of the list. And the old rows carried a 2.4G/5G tag, which
            # was a lie: connecting goes through `nmcli connection up <ssid>`,
            # which takes an SSID and nothing else, so the two band rows for one
            # network did exactly the same thing. Offering a choice that does
            # not exist is worse than not offering it.
            #
            # So: collapse by SSID, keep the strongest signal seen for it, and
            # let the router decide which of its radios answers.
            $2 == "" { next }
            {
                ssid   = $2
                signal = $4 + 0
                if ($1 == "*")                 in_use[ssid]  = 1
                if ($3 != "" && $3 != "--")    secured[ssid] = 1
                if (!(ssid in best) || signal > best[ssid]) best[ssid] = signal
            }
            END {
                for (ssid in best) {
                    signal = best[ssid]

                    if      (signal >= 70) icon = sig_high
                    else if (signal >= 50) icon = sig_med
                    else if (signal >= 30) icon = sig_low
                    else                   icon = sig_none

                    row = icon "  " ssid
                    if (ssid in secured) row = row "  " lock
                    if (ssid in in_use)  row = row "  " dot

                    # Sort key: connected network first, then strongest.
                    rank = (ssid in in_use) ? 0 : (100 - signal)
                    printf "%03d\t%s\n", rank, row
                }
            }' \
        | sort \
        | cut -f2-)

    rescan=no

    # Kick a scan without waiting on it, so the cache the *next* open reads is
    # a fresh one. This is the async request only — the blocking part was never
    # here, it was in `list --rescan auto` above.
    (nmcli device wifi rescan >/dev/null 2>&1 &)

    list=$(
        [ -n "$active_wifi" ] && printf '%s\n' "$DISCONNECT_LABEL"
        printf '%s\n' "$RESCAN_LABEL"
        printf '%s\n' "$networks"
    )

    choice=$(printf '%s' "$list" | fuzzel --dmenu --prompt 'wifi: ' --width 48) || exit 0

    case "$choice" in
        "$RESCAN_LABEL")
            # The one place a scan is worth waiting for, because it's the one
            # place you asked for it.
            rescan=yes
            continue
            ;;
        "$DISCONNECT_LABEL")
            nmcli connection down "$active_wifi" >/dev/null
            notify-send 'WiFi' "Disconnected from $active_wifi"
            exit 0
            ;;
    esac

    # Recover SSID from a network row. Format is:
    #   <icon>  <SSID>  [<lock>]  [<dot>]
    # Strip the leading icon + 2 spaces, then the trailing tags.
    rest=${choice#*  }
    case "$rest" in
        *"  $ACTIVE_DOT") rest=${rest%"  $ACTIVE_DOT"} ;;
    esac
    case "$rest" in
        *"  $LOCK") rest=${rest%"  $LOCK"}; secured=1 ;;
        *)          secured=0 ;;
    esac
    ssid=$rest

    # Saved-connection path — works for both open and secured networks
    # we've connected to before.
    spinner_on
    if nmcli connection up "$ssid" 2>/dev/null; then
        spinner_off
        notify-send 'WiFi' "Connected to $ssid"
        exit 0
    fi
    spinner_off

    # No saved connection. Open networks just connect; secured prompts.
    if [ "$secured" -eq 0 ]; then
        spinner_on
        if nmcli device wifi connect "$ssid"; then
            notify-send 'WiFi' "Connected to $ssid"
        else
            notify-send 'WiFi' "Failed to connect to $ssid"
        fi
        spinner_off
        exit 0
    fi

    pw=$(fuzzel --dmenu --password --prompt "password for $ssid: " --width 40) || exit 0
    spinner_on
    if nmcli device wifi connect "$ssid" password "$pw"; then
        notify-send 'WiFi' "Connected to $ssid"
    else
        notify-send 'WiFi' "Failed to connect to $ssid"
    fi
    spinner_off
    exit 0
done
