#!/usr/bin/env python3
"""Waybar module: a robot glyph that opens the AI usage panel.

Waybar polls this on its interval; claude-usage and codex-usage each serve
their cache unless it has gone stale, so the bar never blocks on the network.
The tooltip carries every window of every tool; clicking opens the dropdown
(ai-usage-panel).

Phosphor icons used:
  robot  U+E762
"""
import json
import os
import subprocess

ROBOT = ""
ELEVATED_PERCENT = 70
HIGH_PERCENT = 90

tools = [
    ("Claude Code", os.path.expanduser("~/.local/bin/claude-usage")),
    ("Codex · GPT-6 Astra", os.path.expanduser("~/.local/bin/codex-usage")),
]


def emit(text, tooltip, css_class):
    print(json.dumps({"text": text, "tooltip": tooltip, "class": css_class}))


def record_of(fetcher):
    return json.loads(subprocess.run([fetcher], capture_output=True, text=True, check=True).stdout)


def tooltip_lines(name, record):
    if not record.get("signed_in"):
        return [f"{name}: signed out"]
    if not record.get("limits"):
        return [f"{name}: usage unavailable"]
    return [name] + [f'  {limit["label"]}: {limit["percent"]}% — {limit["resets"]}' for limit in record["limits"]]


records = [(name, record_of(fetcher)) for name, fetcher in tools]
percents = [limit["percent"] for _, record in records for limit in record.get("limits") or []]
tooltip = "\n".join(line for name, record in records for line in tooltip_lines(name, record))

if not any(record.get("signed_in") for _, record in records):
    emit(ROBOT, tooltip, "signed-out")
elif not percents:
    emit(ROBOT, tooltip, "unavailable")
else:
    worst = max(percents)
    css_class = "high" if worst >= HIGH_PERCENT else "elevated" if worst >= ELEVATED_PERCENT else "normal"
    emit(ROBOT, tooltip, css_class)
