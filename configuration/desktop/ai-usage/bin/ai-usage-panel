#!/bin/sh
# Toggle the AI usage dropdown under the bar. Opening shows the panel at once
# with the last records it had, marked as updating, then forces a fresh fetch
# of each tool in the background and swaps the numbers in when both land; a
# second press closes it. A fetch is a network round trip (about a second),
# and a press that shows nothing for a second reads as a press that was not
# heard.
#
# The compositor decides whether the panel is up. eww's own window list
# has been seen to say nothing is open while the panel was still on
# screen (its daemon had lost track of the window); trusting it then
# stacked a second panel on the first, each press darker, and left the
# open call hanging. When the two disagree the daemon is restarted, which
# takes its surface with it, and any client still waiting on it is killed
# first so a wedged daemon can't wedge the next press too.
set -eu

config="$HOME/.config/ai-usage/eww"
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
eww_cmd() { timeout -s KILL 2 eww --config "$config" "$@"; }

panel_is_on_screen() {
    hyprctl layers -j 2>/dev/null | grep -q -E '"namespace": *"ai-usage"'
}

daemon_tracks_the_panel() {
    eww_cmd active-windows 2>/dev/null | grep -q '^usage'
}

kill_stuck_clients() {
    pkill -9 -f "eww --config $config (open|close|update)" 2>/dev/null || true
}

close_panel() {
    if daemon_tracks_the_panel; then
        eww_cmd close usage >/dev/null 2>&1 || true
    else
        "$HOME/.local/bin/restart-ai-usage"
    fi
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null 2>&1 || true
}

last_record() {
    cat "$cache/$1-usage.json" 2>/dev/null \
        || printf '{"signed_in": true, "limits": []}'
}

refresh_in_background() {
    (
        claude_record="$(mktemp)"
        codex_record="$(mktemp)"
        "$HOME/.local/bin/claude-usage" --force > "$claude_record" &
        "$HOME/.local/bin/codex-usage" --force > "$codex_record" &
        wait
        eww_cmd update claude="$(cat "$claude_record")" codex="$(cat "$codex_record")" refreshing=false >/dev/null 2>&1 || true
        rm -f "$claude_record" "$codex_record"
        pkill -RTMIN+12 waybar 2>/dev/null || true
    ) &
}

open_panel() {
    eww_cmd ping >/dev/null 2>&1 || "$HOME/.local/bin/restart-ai-usage"
    eww_cmd update claude="$(last_record claude)" codex="$(last_record codex)" refreshing=true >/dev/null 2>&1 || true
    eww_cmd open usage >/dev/null 2>&1 || true
    hyprctl dispatch 'hl.dsp.submap("ai-usage")' >/dev/null 2>&1 || true
    refresh_in_background
}

# Open and closed each come with a submap switch: while the panel is up,
# Escape (bound in hyprland.lua's ai-usage submap) closes it.
kill_stuck_clients
if panel_is_on_screen; then
    close_panel
else
    open_panel
fi
