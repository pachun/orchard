#!/bin/sh
# The MagSafe chime: a short sound when the charger is plugged in. Listens
# to udev's power_supply events for the session and plays on the moment
# mains power goes from off to on — plugging in, not unplugging, not the
# burst of events a single plug produces. Runs from hyprland.conf's
# exec-once, so it plays through your own PipeWire and works with the lid
# closed; it can't play while suspended, since plugging in doesn't wake
# the machine.
#
# The sound is orchard's own, synthesized to sit close to Apple's
# PowerChime: E then C a beat apart, ringing together as a soft pad,
# 0.6s. It ships in the feature's sounds/ and is linked in by install.sh.
chime="$HOME/.local/share/orchard/sounds/charge-chime.wav"

# The chime plays at 10% of full volume, always — wherever the system
# volume sits, muted or not. A stream's volume is relative to the sink's,
# so normally the stream is scaled by the inverse of the sink's volume to
# land at 10%. When the sink is muted or already below 10%, no stream
# volume can get there, so the sink is set to exactly 10% (and unmuted)
# for the 0.6s of the chime and then put back as it was.
chime_level=10

play_chime() {
    sink_percent=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oE '[0-9]+%' | head -1 | tr -d %)
    sink_muted=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes' && echo yes || echo no)
    [ -n "$sink_percent" ] || sink_percent=100

    if [ "$sink_muted" = yes ] || [ "$sink_percent" -lt "$chime_level" ]; then
        pactl set-sink-mute @DEFAULT_SINK@ 0
        pactl set-sink-volume @DEFAULT_SINK@ "${chime_level}%"
        pw-play "$chime" >/dev/null 2>&1
        pactl set-sink-volume @DEFAULT_SINK@ "${sink_percent}%"
        [ "$sink_muted" = yes ] && pactl set-sink-mute @DEFAULT_SINK@ 1
    else
        stream_volume=$(awk -v level="$chime_level" -v sink="$sink_percent" 'BEGIN { printf "%.3f", level / sink }')
        pw-play --volume "$stream_volume" "$chime" >/dev/null 2>&1
    fi
}

mains_online() {
    for supply in /sys/class/power_supply/*; do
        [ "$(cat "$supply/type" 2>/dev/null)" = "Mains" ] || continue
        [ "$(cat "$supply/online" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

mains_online && was_online=1 || was_online=0

udevadm monitor --udev --subsystem-match=power_supply 2>/dev/null | while IFS= read -r _; do
    mains_online && now_online=1 || now_online=0
    if [ "$now_online" = 1 ] && [ "$was_online" = 0 ]; then
        play_chime &
    fi
    was_online=$now_online
done
