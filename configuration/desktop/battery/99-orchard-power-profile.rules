# Auto-switch power-profiles-daemon on AC vs battery. PPD deliberately won't do
# this itself, so a udev rule nudges it on each plug/unplug (and once at boot,
# when the power_supply device first appears with its current state).
#
# On battery -> power-saver, which biases the CPU to EPP=power. Measured on this
# machine: a `yarn test` burst runs at ~14W instead of ~40W under balanced, for
# 30% less energy per run and cool enough that the fan stays off — at the cost
# of ~75% more wall-clock. That trade is right on battery and wrong on AC, so on
# AC -> balanced restores full speed. Override by hand from the power menu any
# time; the choice holds until the next plug/unplug.
#
# systemd-run detaches the call so udev isn't blocked waiting on D-Bus; the
# shared --unit name means a rapid plug/unplug can't pile up overlapping runs.
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="0", RUN+="/usr/bin/systemd-run --no-block --collect --unit=orchard-power-profile /usr/bin/powerprofilesctl set power-saver"
SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{online}=="1", RUN+="/usr/bin/systemd-run --no-block --collect --unit=orchard-power-profile /usr/bin/powerprofilesctl set balanced"
