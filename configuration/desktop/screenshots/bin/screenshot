#!/bin/sh
# Capture full screen or a slurp-selected region. Saves to
# ~/pictures/screenshots/<timestamp>.png AND copies to the clipboard,
# so it's immediately available to attach OR paste — no preview popup,
# no annotation step.
#
# Usage: screenshot full|region
set -eu

mode="${1:-region}"
dir="$HOME/pictures/screenshots"
mkdir -p "$dir"
file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
    full)
        grim "$file"
        ;;
    region)
        # Freeze-then-select pattern. hyprpicker -rzd paints a frozen
        # snapshot of the screen as a layer-shell overlay so on-screen
        # UI (fuzzel menus, the bar) stays visible during region
        # selection. Flags:
        #   -r render-inactive — actually freezes the display
        #   -z no-zoom         — drops the magnifying lens hyprpicker
        #                        normally turns the cursor into
        #   -d disable-preview — kills the live color preview that was
        #                        tinting the waybar / hovered surfaces
        hyprpicker -rzd >/dev/null &
        picker_pid=$!
        sleep 0.1   # let hyprpicker paint the frozen overlay
        if ! geom=$(slurp 2>/dev/null); then
            kill "$picker_pid" 2>/dev/null
            exit 0
        fi
        grim -g "$geom" "$file"
        kill "$picker_pid" 2>/dev/null
        ;;
    *)
        echo "usage: $(basename "$0") full|region" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file"
notify-send "Screenshot" "Saved to $file"
