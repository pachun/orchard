#!/usr/bin/env python3
"""Make the keyring PAM unlocks the one every app actually uses.

pam_gnome_keyring only ever unlocks the keyring named "login". On a machine
where something asked for a secret before the keyring feature ran,
gnome-keyring had already minted its own "Default Keyring" with its own
password and made that the default — so chromium, gh and friends keep landing
in the locked vault and prompting, no matter what PAM does at login. This
moves every secret out of whatever keyring is currently the default into
"login", makes "login" the default, and deletes the old keyring. Unlocking each
keyring raises the usual password dialog once, so it needs a live desktop
session and is a no-op without one.

Everything goes through one D-Bus connection on purpose: gnome-keyring scopes
the prompt objects it hands back to the connection that asked, so a shell
script poking at it one busctl call at a time can never answer its own prompt.

gnome-keyring lists a login keyring PAM has just created without exporting it
on D-Bus until the daemon restarts, so a restart is part of the dance the first
time through.

Idempotent.
"""
import os
import subprocess
import sys

import gi

gi.require_version("Secret", "1")
from gi.repository import GLib, Secret

LOGIN_KEYRING_PATH = "/org/freedesktop/secrets/collection/login"


def leave_alone(reason):
    print(f"{reason}; leaving the keyring alone")
    sys.exit(0)


def connect():
    try:
        return Secret.Service.get_sync(Secret.ServiceFlags.LOAD_COLLECTIONS, None)
    except GLib.Error:
        leave_alone("no secret service running")


def reconnect(service):
    Secret.Service.disconnect()
    return connect()


def listed_keyrings(service):
    return list(service.get_cached_property("Collections"))


def exported_keyring(service, path):
    return next((c for c in service.get_collections() if c.get_object_path() == path), None)


def login_keyring(service):
    if LOGIN_KEYRING_PATH not in listed_keyrings(service):
        leave_alone("no login keyring yet; it appears after the first login with PAM in place")
    login = exported_keyring(service, LOGIN_KEYRING_PATH)
    if login is None:
        subprocess.run(["systemctl", "--user", "restart", "gnome-keyring-daemon.service"], check=True)
        service = reconnect(service)
        login = exported_keyring(service, LOGIN_KEYRING_PATH)
    if login is None:
        sys.exit("gnome-keyring lists the login keyring but will not export it")
    return service, login


def default_keyring(service):
    return Secret.Collection.for_alias_sync(service, "default", Secret.CollectionFlags.NONE, None)


def unlock(service, keyrings):
    locked = [k for k in keyrings if k.get_locked()]
    if not locked:
        return service
    unlocked_count, _ = service.unlock_sync(locked, None)
    if unlocked_count < len(locked):
        sys.exit("keyring left locked; nothing moved")
    return reconnect(service)


def items_of(keyring):
    keyring.load_items_sync(None)
    return keyring.get_items()


def copy_into(login, item):
    item.load_secret_sync(None)
    Secret.Item.create_sync(
        login,
        None,
        item.get_attributes(),
        item.get_label(),
        item.get_secret(),
        Secret.ItemCreateFlags.REPLACE,
        None,
    )
    copied = login.search_sync(None, item.get_attributes(), Secret.SearchFlags.NONE, None)
    if not copied:
        sys.exit(f"could not find '{item.get_label()}' in the login keyring after copying it")
    print(f"moved: {item.get_label()}")


def main():
    if not os.environ.get("WAYLAND_DISPLAY"):
        leave_alone("not inside a desktop session")
    service = connect()
    service, login = login_keyring(service)
    old_default = default_keyring(service)

    if old_default is not None and old_default.get_object_path() == LOGIN_KEYRING_PATH:
        print("login is already the default keyring")
        return

    if old_default is not None:
        service = unlock(service, [old_default, login])
        login = exported_keyring(service, LOGIN_KEYRING_PATH)
        old_default = default_keyring(service)
        for item in items_of(old_default):
            copy_into(login, item)

    service.set_alias_sync("default", login, None)
    if old_default is not None:
        old_default.delete_sync(None)
    print("login is now the default keyring")


main()
