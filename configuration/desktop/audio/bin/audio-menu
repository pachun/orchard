#!/bin/sh
# Pick where sound comes out. Lists every usable output — the laptop itself,
# headphones, HDMI, bluetooth, and any AirPlay speaker the airplay feature has
# discovered — and switches to the chosen one. Bound to Cmd+Shift+A, and to a
# click on waybar's speaker icon.
#
# Switching is audio_switch_to in _audio-sinks (shared with the Bluetooth
# watcher): set the default sink and move every stream already playing.
#
# Why an OS-level picker exists at all: the Spotify web player's own device
# list only enumerates Spotify Connect and Google Cast devices — it cannot see
# a system audio sink, so AirPlay speakers will never appear in it. AirPlay
# here is a PipeWire sink, so the choice belongs to the OS. Send the browser's
# audio to a HomePod from this menu and Spotify is none the wiser.
#
# Row format mirrors wifi-menu / nordvpn-menu: leading icon, name, and a
# trailing ● on the current output. The sink list and icons are shared with
# waybar's module — see _audio-sinks, which also explains why the listing is
# built the way it is (a hotkey-bound picker cannot afford to be slow).
set -eu

. "$HOME/.local/bin/_fuzzel-menu-toggle"
. "$HOME/.local/bin/_audio-sinks"

ACTIVE_DOT='●'

current=$(audio_current_sink)
# The pipe sink itself never belongs in the picker — choosing it would send
# audio to whatever OwnTone last had enabled, or nowhere. The speakers it
# feeds are listed individually.
outputs=$(audio_outputs | awk -F'\t' '$1 != "airplay_sink"')

# Current output first (the 0/1 sort key), then alphabetical.
rows=$(
    printf '%s\n' "$outputs" | awk -F'\t' -v current="$current" -v dot="$ACTIVE_DOT" '
        $1 == "" { next }
        $1 == current { printf "0\t%s  %s  %s\n", $3, $2, dot; next }
                      { printf "1\t%s  %s\n",     $3, $2 }
    ' | sort | cut -f2-
)

choice=$(printf '%s' "$rows" | fuzzel --dmenu --prompt 'output: ' --width 34 --lines 12) || exit 0

label=${choice#*  }
case "$label" in
    *"  $ACTIVE_DOT") label=${label%"  $ACTIVE_DOT"} ;;
esac

sink=$(printf '%s\n' "$outputs" | awk -F'\t' -v l="$label" '$2 == l { print $1; exit }')
[ -n "$sink" ] || exit 0

# An AirPlay speaker is an OwnTone output, not a PipeWire sink: enable it
# there, walk through device verification if the speaker wants it (the PIN
# appears on its screen), and then route audio into the pipe sink OwnTone
# reads from.
case "$sink" in
    owntone:*)
        id=${sink#owntone:}
        curl -fsS -m 3 -X PUT "$OWNTONE_API/outputs/set" \
            --data "{\"outputs\":[\"$id\"]}" >/dev/null 2>&1 || true

        # Verification is demanded lazily: the flags flip only once OwnTone
        # has actually tried to connect, a beat after the PUT above.
        sleep 1
        needs_pin=$(owntone_airplay_outputs | awk -F'\t' -v id="$id" \
            '$1 == id { print ($3 == "false" && $4 == "true") ? "yes" : "no"; exit }')
        if [ "$needs_pin" = "yes" ]; then
            notify-send 'Output' "$label wants to verify this computer — read the PIN off its screen" >/dev/null 2>&1 || true
            pin=$(printf '' | fuzzel --dmenu --prompt "PIN on $label: " --lines 0) || exit 0
            [ -n "$pin" ] || exit 0
            curl -fsS -m 5 -X PUT "$OWNTONE_API/outputs/$id" \
                --data "{\"pin\":\"$pin\"}" >/dev/null 2>&1 || true
            curl -fsS -m 3 -X PUT "$OWNTONE_API/outputs/set" \
                --data "{\"outputs\":[\"$id\"]}" >/dev/null 2>&1 || true
            if ! owntone_airplay_outputs | awk -F'\t' -v id="$id" \
                '$1 == id && $3 == "true" { found = 1 } END { exit !found }'; then
                notify-send --urgency=critical 'Output' "$label did not accept the PIN — pick it again for a fresh one" >/dev/null 2>&1 || true
                exit 1
            fi
        fi
        sink="airplay_sink"
        ;;
esac

audio_switch_to "$sink" "$label"
