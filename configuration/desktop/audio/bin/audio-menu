#!/bin/sh
# Pick where sound comes out and which microphone it comes in from. Lists
# every usable output — the laptop itself, headphones, HDMI, bluetooth, and
# any AirPlay speaker the airplay feature has discovered — then every usable
# microphone, and switches to the chosen one. Bound to Cmd+Shift+A, and to a
# click on waybar's speaker icon.
#
# Switching is audio_switch_to and audio_switch_input_to in _audio-sinks
# (the first shared with the Bluetooth watcher): set the default device and
# move every stream already using the old one.
#
# Why an OS-level picker exists at all: the Spotify web player's own device
# list only enumerates Spotify Connect and Google Cast devices — it cannot see
# a system audio sink, so AirPlay speakers will never appear in it. AirPlay
# here is a PipeWire sink, so the choice belongs to the OS. Send the browser's
# audio to a HomePod from this menu and Spotify is none the wiser.
#
# Row format mirrors wifi-menu / nordvpn-menu: leading icon, name, and a
# trailing ● on the current output and the current microphone. Microphones
# all wear the microphone icon, which is what tells a headset's microphone
# from the same headset's speakers. The device lists and icons are shared with
# waybar's module — see _audio-sinks, which also explains why the listing is
# built the way it is (a hotkey-bound picker cannot afford to be slow).
set -eu

. "$HOME/.local/bin/_menu-toggle"
. "$HOME/.local/bin/_audio-sinks"

ACTIVE_DOT='●'

current_output=$(audio_current_sink)
current_input=$(audio_current_source)
# The pipe sink itself never belongs in the picker — choosing it would send
# audio to whatever OwnTone last had enabled, or nowhere. The speakers it
# feeds are listed individually.
outputs=$(audio_outputs | awk -F'\t' '$1 != "airplay_sink"')
inputs=$(audio_inputs)

# Current device first (the 0/1 sort key), then alphabetical.
rows_for() {
    devices=$1; current=$2
    printf '%s\n' "$devices" | awk -F'\t' -v current="$current" -v dot="$ACTIVE_DOT" '
        $1 == "" { next }
        $1 == current { printf "0\t%s  %s  %s\n", $3, $2, dot; next }
                      { printf "1\t%s  %s\n",     $3, $2 }
    ' | sort | cut -f2-
}

rows=$(rows_for "$outputs" "$current_output"; rows_for "$inputs" "$current_input")

choice=$(printf '%s' "$rows" | "$HOME/.local/bin/orchard-menu" --prompt 'sound: ') || exit 0

chosen_row=$choice
case "$chosen_row" in
    *"  $ACTIVE_DOT") chosen_row=${chosen_row%"  $ACTIVE_DOT"} ;;
esac
label=${chosen_row#*  }

device_shown_as_chosen_row() {
    devices=$1
    printf '%s\n' "$devices" | awk -F'\t' -v row="$chosen_row" '$3 "  " $2 == row { print $1; exit }'
}

input=$(device_shown_as_chosen_row "$inputs")
if [ -n "$input" ]; then
    audio_switch_input_to "$input" "$label"
    exit 0
fi

sink=$(device_shown_as_chosen_row "$outputs")
[ -n "$sink" ] || exit 0

# An AirPlay speaker is an OwnTone output, not a PipeWire sink: enable it
# there, walk through device verification if the speaker wants it (the PIN
# appears on its screen), and then route audio into the pipe sink OwnTone
# reads from.
ask_owntone_to_play_on() {
    curl -fsS -m 3 -X PUT "$OWNTONE_API/outputs/set" \
        --data "{\"outputs\":[\"$1\"]}" >/dev/null 2>&1 || true
}

# "playing", "wants_pin", or "refused" once OwnTone has finished trying.
# OwnTone answers the request before it has connected, so the speaker's
# flags only settle a beat later; a speaker that turns the connection down
# never flips any of them.
answer_from_speaker() {
    polls_remaining=$((slowest_expected_connection_seconds * polls_per_second))
    while [ "$polls_remaining" -gt 0 ]; do
        answer=$(owntone_airplay_outputs | awk -F'\t' -v id="$1" '
            $1 == id && $3 == "true" { print "playing"; exit }
            $1 == id && $4 == "true" { print "wants_pin"; exit }')
        if [ -n "$answer" ]; then
            printf '%s\n' "$answer"
            return
        fi
        sleep 0.25
        polls_remaining=$((polls_remaining - 1))
    done
    printf 'refused\n'
}
slowest_expected_connection_seconds=4
polls_per_second=4

case "$sink" in
    owntone:*)
        id=${sink#owntone:}
        ask_owntone_to_play_on "$id"
        answer=$(answer_from_speaker "$id")

        if [ "$answer" = "wants_pin" ]; then
            notify-send 'Output' "$label wants to verify this computer — read the PIN off its screen" >/dev/null 2>&1 || true
            pin=$(printf '' | "$HOME/.local/bin/orchard-menu" --prompt "PIN on $label: ") || exit 0
            [ -n "$pin" ] || exit 0
            curl -fsS -m 5 -X PUT "$OWNTONE_API/outputs/$id" \
                --data "{\"pin\":\"$pin\"}" >/dev/null 2>&1 || true
            ask_owntone_to_play_on "$id"
            if [ "$(answer_from_speaker "$id")" != "playing" ]; then
                notify-send --urgency=critical 'Output' "$label did not accept the PIN — pick it again for a fresh one" >/dev/null 2>&1 || true
                exit 1
            fi
        fi

        # Switching to the pipe anyway would send sound to no speaker at all.
        if [ "$answer" = "refused" ]; then
            notify-send --urgency=critical 'Output' "$label turned the connection down — sound stays where it was" >/dev/null 2>&1 || true
            exit 1
        fi
        sink="airplay_sink"
        ;;
esac

audio_switch_to "$sink" "$label"
