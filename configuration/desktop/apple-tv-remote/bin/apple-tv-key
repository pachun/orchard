#!/usr/bin/env python3
"""Every key of Apple TV mode lands here (from hyprland.conf's appletv
submap), and the card in the corner is redrawn to match. Three states:

  picker   j/k move, Enter connects a paired TV or starts pairing an
           unpaired one, Esc/q closes the mode.
  pairing  the TV is showing a PIN; digits type it into the card,
           Backspace edits, Enter submits, Esc cancels back to the picker.
  waking   the chosen TV was asleep; it is being woken and the remote
           follows as soon as it answers.
  remote   the vim keys drive the TV through one atvremote REPL that holds
           the Companion connection open (a keypress is a FIFO write, not a
           handshake). p puts the TV to sleep, s switches device, Esc/q
           closes the mode.

Waking: an Apple TV in standby still answers on the network, and turn_on
brings it (and, over HDMI-CEC, the TV and sound system) up. One that has
gone fully dark answers nothing; the only handle left is Wake-on-LAN, so
each TV's address and MAC are learned whenever it is seen awake and magic
packets go to that MAC until it comes back.

The picker's default is the TV you used last time you were *here*: choices
are remembered per Wi-Fi BSSID — on a mesh, the laptop associates with the
nearest node, so the BSSID stands in for the room the way the iPhone
remote's BLE proximity does — with last-used as the fallback.
"""
import json
import os
import re
import subprocess
import sys
import time

RUNTIME = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "apple-tv-remote")
REGISTRY = os.path.expanduser("~/.config/orchard/apple-tvs")
DEFAULTS = os.path.expanduser("~/.local/state/orchard/apple-tv-defaults.json")
ATVREMOTE = os.path.expanduser("~/.local/bin/atvremote")
EWW_CONFIG = os.path.expanduser("~/.config/apple-tv-remote/eww")


def eww(*args):
    subprocess.run(["eww", "--config", EWW_CONFIG, *args],
                   capture_output=True, timeout=2)


def state_path(name):
    return os.path.join(RUNTIME, name)


def read_state():
    try:
        return json.load(open(state_path("state.json")))
    except (OSError, ValueError):
        return None


def write_state(state):
    with open(state_path("state.json"), "w") as f:
        json.dump(state, f)


def registry_devices():
    devices = []
    try:
        for line in open(REGISTRY):
            device_id, _, name = line.strip().partition(" ")
            if device_id:
                devices.append({"id": device_id, "name": name, "paired": True})
    except OSError:
        pass
    return devices


SCAN_RESULTS = os.path.expanduser("~/.local/state/orchard/apple-tv-scan-results")
HARDWARE = os.path.expanduser("~/.local/state/orchard/apple-tv-hardware.json")


def scanned_devices():
    try:
        return [{**d, "paired": False} for d in json.load(open(SCAN_RESULTS))]
    except (OSError, ValueError):
        return []


def read_hardware():
    try:
        return json.load(open(HARDWARE))
    except (OSError, ValueError):
        return {}


def remember_hardware(device_id, **facts):
    hardware = read_hardware()
    hardware[device_id] = {**hardware.get(device_id, {}), **{k: v for k, v in facts.items() if v}}
    os.makedirs(os.path.dirname(HARDWARE), exist_ok=True)
    with open(HARDWARE, "w") as f:
        json.dump(hardware, f)


def mac_for_ip(ip):
    try:
        out = subprocess.run(["ip", "neigh", "show", ip], capture_output=True, text=True, timeout=3).stdout
        match = re.search(r"lladdr ([0-9a-f:]{17})", out)
        return match.group(1) if match else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def power_state(device):
    """'on', 'off' (standby, still on the network), or None when unreachable."""
    ip = read_hardware().get(device["id"], {}).get("ip")
    command = [ATVREMOTE] + (["-s", ip] if ip else []) + ["--id", device["id"], "power_state"]
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=12).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    if "PowerState.On" in out:
        return "on"
    if "PowerState.Off" in out:
        return "off"
    return None


def send_magic_packets(mac):
    import socket
    payload = bytes.fromhex("ff" * 6 + mac.replace(":", "") * 16)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for _ in range(3):
            sock.sendto(payload, ("255.255.255.255", 9))


def turn_on(device):
    ip = read_hardware().get(device["id"], {}).get("ip")
    command = [ATVREMOTE] + (["-s", ip] if ip else []) + ["--id", device["id"], "turn_on"]
    subprocess.run(command, capture_output=True, timeout=20)


def wake(state, device):
    """Bring the TV up, whichever kind of asleep it is. Returns True when it answers."""
    state["mode"] = "waking"
    state["device"] = device
    write_state(state)
    eww("update", f"device_name={device['name']}", "mode=waking",
        "waking_note=Waking it up…")
    current = power_state(device)
    if current == "on":
        return True
    if current == "off":
        turn_on(device)
        deadline = time.time() + 20
        while time.time() < deadline:
            if power_state(device) == "on":
                return True
            time.sleep(1)
        return False
    mac = read_hardware().get(device["id"], {}).get("mac")
    if not mac:
        eww("update", "waking_note=Off the network, and I haven't\nseen it awake yet. Wake it with its\nown remote once so I learn its MAC.")
        return False
    deadline = time.time() + 40
    while time.time() < deadline:
        send_magic_packets(mac)
        time.sleep(4)
        if power_state(device) is not None:
            turn_on(device)
            return True
    eww("update", "waking_note=No answer to Wake-on-LAN.\nIs it on Wi-Fi rather than\nEthernet?")
    return False


def read_defaults():
    try:
        return json.load(open(DEFAULTS))
    except (OSError, ValueError):
        return {"bssids": {}, "last": None}


def current_bssid():
    try:
        out = subprocess.run(
            ["nmcli", "-t", "-f", "ACTIVE,BSSID", "dev", "wifi", "list", "--rescan", "no"],
            capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            if line.startswith("yes:"):
                return line[4:].replace("\\:", ":")
    except (OSError, subprocess.TimeoutExpired):
        pass
    return None


def remember_choice(device_id):
    defaults = read_defaults()
    defaults["last"] = device_id
    bssid = current_bssid()
    if bssid:
        defaults["bssids"][bssid] = device_id
    os.makedirs(os.path.dirname(DEFAULTS), exist_ok=True)
    with open(DEFAULTS, "w") as f:
        json.dump(defaults, f)


def preferred_device_id():
    defaults = read_defaults()
    return defaults["bssids"].get(current_bssid() or "") or defaults.get("last")


def merged_devices(state):
    devices = registry_devices()
    known = {d["id"] for d in devices}
    devices.extend(d for d in scanned_devices() if d["id"] not in known)
    return devices


def shown_pin(pin):
    return " ".join(pin) if pin else "· · · ·"


def show_picker(state):
    devices = state["devices"]
    eww("update", f"picker_note={state.get('picker_note', '')}")
    rows = [{"name": d["name"],
             "hint": "" if d["paired"] else "pair",
             "selected": i == state["selection"]}
            for i, d in enumerate(devices)]
    eww("update", f"devices={json.dumps(rows)}",
        f"scanning={'true' if state['scanning'] else 'false'}",
        "mode=picker")


def enter_picker(state):
    state["mode"] = "picker"
    state["devices"] = merged_devices(state)
    preferred = preferred_device_id()
    ids = [d["id"] for d in state["devices"]]
    state["selection"] = ids.index(preferred) if preferred in ids else 0
    write_state(state)
    show_picker(state)


def start_session(state, device):
    if not wake(state, device):
        state["mode"] = "waking"
        state["wake_failed"] = True
        write_state(state)
        return
    ip = read_hardware().get(device["id"], {}).get("ip")
    remember_hardware(device["id"], ip=ip, mac=mac_for_ip(ip) if ip else None)
    commands = state_path("session-commands")
    if not os.path.exists(commands):
        os.mkfifo(commands, 0o600)
    with open(state_path("session.log"), "wb") as log:
        process = subprocess.Popen(
            [ATVREMOTE, "--id", device["id"], "cli"],
            stdin=open(commands, "r+b", buffering=0), stdout=log, stderr=log)
    with open(state_path("session.pid"), "w") as f:
        f.write(str(process.pid))
    state["mode"] = "remote"
    state["device"] = device
    write_state(state)
    remember_choice(device["id"])
    eww("update", f"device_name={device['name']}", "mode=remote")


def end_session():
    try:
        pid = int(open(state_path("session.pid")).read())
        os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    for name in ("session.pid", "session-commands", "session.log"):
        try:
            os.remove(state_path(name))
        except OSError:
            pass


def start_pairing(state, device):
    pin_fifo = state_path("pairing-pin")
    if not os.path.exists(pin_fifo):
        os.mkfifo(pin_fifo, 0o600)
    with open(state_path("pairing.log"), "wb") as log:
        process = subprocess.Popen(
            [ATVREMOTE, "--id", device["id"], "--protocol", "companion", "pair"],
            stdin=open(pin_fifo, "r+b", buffering=0), stdout=log, stderr=log)
    with open(state_path("pairing.pid"), "w") as f:
        f.write(str(process.pid))
    state["mode"] = "pairing"
    state["device"] = device
    state["pin"] = ""
    state["pairing_error"] = ""
    write_state(state)
    eww("update", f"device_name={device['name']}", f"pin={shown_pin('')}", "pairing_error=", "mode=pairing")


def cancel_pairing(state):
    try:
        pid = int(open(state_path("pairing.pid")).read())
        os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    for name in ("pairing.pid", "pairing-pin", "pairing.log"):
        try:
            os.remove(state_path(name))
        except OSError:
            pass


def submit_pin(state):
    device = state["device"]
    with open(state_path("pairing-pin"), "w") as f:
        f.write(state["pin"] + "\n")
    pid = int(open(state_path("pairing.pid")).read())
    deadline = time.time() + 25
    exit_code = None
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            exit_code = 0
            break
        time.sleep(0.3)
    log = ""
    try:
        log = open(state_path("pairing.log"), errors="replace").read()
    except OSError:
        pass
    paired = exit_code == 0 and "Pairing seems to have succeeded" in log
    cancel_pairing(state)
    if paired:
        os.makedirs(os.path.dirname(REGISTRY), exist_ok=True)
        with open(REGISTRY, "a") as f:
            f.write(f"{device['id']} {device['name']}\n")
        start_session(state, {**device, "paired": True})
    else:
        state["pairing_error"] = "That PIN didn't take — Esc, then try again"
        state["pin"] = ""
        write_state(state)
        eww("update", f"pin={shown_pin('')}", f"pairing_error={state['pairing_error']}")


def session_alive():
    try:
        os.kill(int(open(state_path("session.pid")).read()), 0)
        return True
    except (OSError, ValueError):
        return False


def press_remote(state, command):
    # Opening a FIFO for writing blocks until a reader exists. If the REPL
    # has died — the TV went to sleep and dropped the connection — a plain
    # open() would hang this process forever and leave the card stuck. Open
    # non-blocking: no reader means no session, so fall back to the picker.
    try:
        fd = os.open(state_path("session-commands"), os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, (command + "\n").encode())
        os.close(fd)
    except OSError:
        session_lost(state)


def session_lost(state):
    end_session()
    state["picker_note"] = f"Lost {state['device']['name']} — did it go to sleep?"
    enter_picker(state)


def fire_volume(device_id, direction):
    # Companion volume presses send the HID key and then block five seconds
    # waiting for a volume level the TV never reports (it hands volume to the
    # HDMI-connected TV/AVR), which wedges the persistent REPL. The key is
    # already out by the time it waits, so fire it as a throwaway one-shot:
    # the volume moves, and the doomed wait dies in a process nobody joins.
    subprocess.Popen(
        [ATVREMOTE, "--id", device_id, f"volume_{direction}"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)


REMOTE_COMMANDS = {
    "h": "left", "j": "down", "k": "up", "l": "right",
    "enter": "select", "space": "play_pause", "m": "menu",
    "home": "home", "previous": "previous", "next": "next",
}


def close_mode():
    subprocess.run([os.path.expanduser("~/.local/bin/apple-tv-mode")],
                   capture_output=True)


def main():
    if not os.path.isdir(RUNTIME):
        sys.exit(0)
    key = sys.argv[1]

    if key == "open":
        state = {"mode": "picker", "devices": [], "selection": 0,
                 "scanning": True, "device": None, "pin": ""}
        enter_picker(state)
        return

    state = read_state()
    if state is None:
        sys.exit(0)

    if key == "scan-finished":
        for seen in scanned_devices():
            remember_hardware(seen["id"], ip=seen["ip"], mac=mac_for_ip(seen["ip"]))
        if state["mode"] == "picker":
            state["scanning"] = False
            state["devices"] = merged_devices(state)
            state["selection"] = min(state["selection"], max(len(state["devices"]) - 1, 0))
            write_state(state)
            show_picker(state)
        else:
            state["scanning"] = False
            write_state(state)
        return

    mode = state["mode"]
    if mode == "picker":
        state["picker_note"] = ""
        if key in ("j", "k") and state["devices"]:
            step = 1 if key == "j" else -1
            state["selection"] = (state["selection"] + step) % len(state["devices"])
            write_state(state)
            show_picker(state)
        elif key == "enter" and state["devices"]:
            device = state["devices"][state["selection"]]
            if device["paired"]:
                start_session(state, device)
            else:
                start_pairing(state, device)
        elif key in ("escape", "q"):
            close_mode()
    elif mode == "pairing":
        if key.isdigit() and len(state["pin"]) < 6:
            state["pin"] += key
            write_state(state)
            eww("update", f"pin={shown_pin(state['pin'])}")
        elif key == "backspace":
            state["pin"] = state["pin"][:-1]
            write_state(state)
            eww("update", f"pin={shown_pin(state['pin'])}")
        elif key == "enter" and state["pin"]:
            submit_pin(state)
        elif key in ("escape", "q"):
            cancel_pairing(state)
            enter_picker(state)
    elif mode == "waking":
        if key in ("escape", "q"):
            close_mode()
    elif mode == "remote":
        if not session_alive():
            session_lost(state)
        elif key == "p":
            ip = read_hardware().get(state["device"]["id"], {}).get("ip")
            subprocess.Popen(
                [ATVREMOTE] + (["-s", ip] if ip else []) + ["--id", state["device"]["id"], "turn_off"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, start_new_session=True)
        elif key == "s":
            end_session()
            enter_picker(state)
        elif key in ("escape", "q"):
            close_mode()
        elif key == "minus":
            fire_volume(state["device"]["id"], "down")
        elif key == "equal":
            fire_volume(state["device"]["id"], "up")
        elif key in REMOTE_COMMANDS:
            press_remote(state, REMOTE_COMMANDS[key])


if __name__ == "__main__":
    main()
