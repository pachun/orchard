#!/bin/sh
# Toggle Apple TV mode: a card in the bar's corner and a Hyprland submap
# that hands every key to apple-tv-key. The card opens as a device picker
# (paired TVs instantly, a scan filling in the rest), pairs unpaired ones
# right there (the PIN typed into the card), and becomes the which-key
# remote once connected. apple-tv-key owns all of that state; this script
# only opens and tears down.
set -eu

runtime="${XDG_RUNTIME_DIR:-/tmp}/apple-tv-remote"
config="$HOME/.config/apple-tv-remote/eww"
eww_cmd() { timeout 2 eww --config "$config" "$@"; }

card_is_still_up() {
    hyprctl layers -j 2>/dev/null | grep -q '"namespace": "apple-tv-remote"'
}

if [ -d "$runtime" ]; then
    hyprctl dispatch submap reset >/dev/null 2>&1 || true
    for pidfile in "$runtime"/*.pid; do
        [ -f "$pidfile" ] && kill "$(cat "$pidfile")" 2>/dev/null || true
    done
    # A key handler still mid-wake, or wedged on a dead session's FIFO,
    # must not outlive the mode.
    pkill -f '^python3 .*/apple-tv-key' 2>/dev/null || true
    rm -rf "$runtime"
    eww_cmd close remote >/dev/null 2>&1 || true
    # eww can lose track of its own window; if the surface is still on
    # screen, a fresh daemon is the one reliable way to take it down.
    if card_is_still_up; then
        "$HOME/.local/bin/restart-apple-tv-remote"
    fi
    exit 0
fi

mkdir -p "$runtime"
eww_cmd ping >/dev/null 2>&1 || "$HOME/.local/bin/restart-apple-tv-remote"

"$HOME/.local/bin/apple-tv-key" open
"$HOME/.local/bin/apple-tv-scan" &
printf '%s\n' "$!" > "$runtime/scan.pid"

eww_cmd open remote >/dev/null 2>&1 || true
hyprctl dispatch submap appletv >/dev/null 2>&1 || true
