#!/usr/bin/env bash
# Regenerate the remote card's colours from the active orchard theme: panel
# from the background, text from the foreground, keycaps from the accent
# (ANSI 4). Run by install.sh and again by set-theme on every switch.
set -euo pipefail

palette="$HOME/.config/orchard-themes/active/palette"
[ -f "$palette" ] || exit 0

read_hex() { grep -E "^$1[[:space:]]*=" "$palette" | grep -oE '#[0-9a-fA-F]{6}' | head -n1; }
panel_hex=$(read_hex background)
ink_hex=$(read_hex foreground)
accent_hex=$(read_hex "palette = 4")
[ -n "$panel_hex" ] && [ -n "$ink_hex" ] && [ -n "$accent_hex" ] || exit 0

as_rgb() { local h=${1#\#}; printf '%d, %d, %d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
panel_rgb=$(as_rgb "$panel_hex")
ink_rgb=$(as_rgb "$ink_hex")

mkdir -p "$HOME/.config/apple-tv-remote/eww"
cat > "$HOME/.config/apple-tv-remote/eww/colors.scss" <<SCSS
\$panel:  rgba($panel_rgb, 0.80);
\$key:    rgba($ink_rgb, 0.12);
\$ink:    $ink_hex;
\$dim:    rgba($ink_rgb, 0.60);
\$accent: $accent_hex;
SCSS
cat > "$HOME/.config/apple-tv-remote/eww/colors.yuck" <<YUCK
(defvar ink "$ink_hex")
YUCK
