#!/bin/sh
# Find the Apple TVs. The previous scan's results are kept in state, so
# the picker fills instantly on open; this rescan runs in the background
# (started by apple-tv-mode) and refreshes the list when it lands.
set -eu
runtime="${XDG_RUNTIME_DIR:-/tmp}/apple-tv-remote"
[ -d "$runtime" ] || exit 0
results="$HOME/.local/state/orchard/apple-tv-scan-results"
mkdir -p "$(dirname "$results")"

"$HOME/.local/bin/atvremote" scan --scan-timeout 6 2>/dev/null | python3 -c '
import re, sys
found = []
for block in sys.stdin.read().split("\n\n"):
    name = re.search(r"^ *Name: (.+)$", block, re.M)
    model = re.search(r"^ *Model/SW: (.+)$", block, re.M)
    mac = re.search(r"^ - ([0-9A-F]{2}(?::[0-9A-F]{2}){5})$", block, re.M)
    companion = re.search(r"Protocol: Companion.*Pairing: Mandatory", block)
    if name and model and mac and companion and "Apple TV" in model.group(1):
        print(f"{mac.group(1)} {name.group(1)}")
' > "$results.new"
mv "$results.new" "$results"

[ -d "$runtime" ] && "$HOME/.local/bin/apple-tv-key" scan-finished
