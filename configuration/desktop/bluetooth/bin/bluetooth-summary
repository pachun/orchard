#!/bin/sh
set -eu

powered=$(bluetoothctl show 2>/dev/null | awk -F': *' '/Powered:/ { print $2; exit }')
if [ "$powered" != yes ]; then
    echo Off
    exit 0
fi

connected=$(bluetoothctl devices Connected 2>/dev/null | sed 's/^Device [^ ]* //' | paste -sd, - | sed 's/,/, /g')
printf '%s\n' "${connected:-On}"
