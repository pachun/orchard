#!/usr/bin/env python3
"""Start an app into its scratchpad, so it is running and never seen.

    launch-hidden bluebubbles bluebubbles

The app comes up, connects, and sits in exactly the place Cmd+I would put it if
you had opened it and hidden it again — Hyprland's special workspace, named for
the class, which is what focus-or-launch treats as "minimized". A text arrives as
a notification without a window ever having appeared, and Cmd+I brings it out as
though you had stashed it yourself.

The window is caught on Hyprland's event socket rather than by polling for it. On
`openwindow` the window exists but has not been drawn, so moving it there is
invisible — the same trick hypr-workspace-cap uses, and the reason you never see
a stray window land on the wrong desktop either.

Two things that don't work, for the next person who tries them:

Hyprland's exec dispatcher takes inline window rules, and
`[workspace special:bluebubbles silent] bluebubbles` looks exactly right. It
works for an app that maps a window in under a second, and it silently does not
for BlueBubbles, which takes twelve — the rule is tied to the pid it launched and
the association is gone by the time the window arrives.

A plain `windowrule` on the class would work, and would also catch the window
Cmd+I launches — so the first Cmd+I after a cold start would open the app into
the scratchpad and show you nothing. The rule has to apply to this launch and no
other, which is why this is a script and not a line of config.
"""
import json
import os
import socket
import subprocess
import sys

if len(sys.argv) < 3:
    sys.exit("usage: launch-hidden <window-class> <command...>")

window_class, command = sys.argv[1], sys.argv[2:]
scratchpad = f"special:{window_class}"

instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
if not instance:
    sys.exit("launch-hidden: not inside a Hyprland session")

runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
events = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
events.connect(f"{runtime}/hypr/{instance}/.socket2.sock")

# Listen before launching. An app that starts fast would otherwise open its
# window while we were still connecting, and we would wait for an event that had
# already happened.
subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

unread = b""
while True:
    arrived = events.recv(4096)
    if not arrived:
        break
    unread += arrived
    while b"\n" in unread:
        line, unread = unread.split(b"\n", 1)
        name, _, payload = line.decode(errors="replace").partition(">>")
        if name != "openwindow":
            continue
        # openwindow>>address,workspace,class,title
        fields = payload.split(",", 3)
        if len(fields) < 3 or fields[2] != window_class:
            continue
        subprocess.run(
            [
                "hyprctl", "dispatch", "movetoworkspacesilent",
                f"{scratchpad},address:0x{fields[0]}",
            ],
            stdout=subprocess.DEVNULL,
            check=False,
        )
        sys.exit(0)
