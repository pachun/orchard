#!/usr/bin/env bash
# Step to the next or previous workspace, wrapping at both ends. Bound to
# Ctrl+Left/Right in hyprland.lua.
#
# The ring is workspaces 1..5 — always, whether or not they hold anything, so
# the five you see in the bar are the five you can reach — *plus* any workspace
# above 5 that currently exists.
#
# That last part is for the docked layout: with 1..5 pinned to the external
# monitor, the laptop panel holds a space of its own above them, and Cmd+1..5
# (xremap binds those five digits and no more) can't reach it. Walking whatever
# exists keeps that space somewhere you can go. New windows themselves are
# always placed within 1..5 (see hyprland.lua), so nothing lands above five on
# its own.
#
# The ring only ever grows to cover workspaces that *exist*, so there's still no
# way to drift rightwards into an endless plain of empty desktops.
#
# Usage: workspace-cycle left|right
set -euo pipefail

PERSISTENT=5

direction="${1:-}"
[ "$direction" = "left" ] || [ "$direction" = "right" ] || {
    echo "usage: $(basename "$0") left|right" >&2
    exit 2
}

current=$(hyprctl activeworkspace -j | jq '.id')

# Special workspaces — the scratchpad focus-or-launch hides windows in — carry
# negative ids and have their own keybinds. They're never part of the ring.
highest_existing=$(hyprctl workspaces -j | jq '[.[] | select(.id > 0) | .id] | max // 0')

last=$PERSISTENT
[ "$highest_existing" -gt "$last" ] && last=$highest_existing

case "$direction" in
    right)
        target=$((current + 1))
        [ "$target" -gt "$last" ] && target=1
        ;;
    left)
        target=$((current - 1))
        [ "$target" -lt 1 ] && target=$last
        ;;
esac

# Via workspace-switch rather than hyprctl directly, so that stepping onto a
# workspace that lives on the other monitor takes focus with it.
workspace-switch "$target"
