#!/usr/bin/env python3
"""Subscribe to Hyprland's event socket and, whenever the active workspace
becomes empty as the result of a window closing or moving, switch focus
to the closest workspace that *still has windows*. If no other populated
workspace exists, stay put rather than warp to another empty one.

Only a window leaving the workspace you are looking at counts. A window
closing somewhere else — the music visualizer toggled off from the bar, a
download dialog finishing on another desktop — must not move you, even if
the desktop you are on happens to be empty. Each window's workspace is
remembered from its open/move events so a close can be attributed.

Hyprland's `workspace previous` dispatcher only knows the last-used
workspace, not whether it still has content — so chained closes (close,
close, close) would just walk back through a trail of empty workspaces.
This script picks the closest populated one by id distance instead.
Works for any close path (Cmd+Q, ghostty Cmd+W, app self-quit, etc.).
"""
import json
import os
import socket
import subprocess
import sys

instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
if not instance:
    sys.exit("HYPRLAND_INSTANCE_SIGNATURE not set; not inside a Hyprland session?")

sock_path = f"{xdg_runtime}/hypr/{instance}/.socket2.sock"


def hyprctl_json(*args):
    out = subprocess.run(
        ["hyprctl", *args, "-j"], capture_output=True, text=True, check=False
    ).stdout
    return json.loads(out) if out else None


def active_workspace():
    return hyprctl_json("activeworkspace") or {}


def jump_back_if_empty():
    ws = active_workspace()
    ws_id = ws.get("id")
    if ws_id is None:
        return

    clients = hyprctl_json("clients") or []

    # Still has windows? Nothing to do.
    if any(c.get("workspace", {}).get("id") == ws_id for c in clients):
        return

    # Collect workspace ids that have at least one window, excluding the
    # current (now-empty) one.
    populated = {
        c["workspace"]["id"] for c in clients
        if c.get("workspace", {}).get("id") not in (None, ws_id)
    }
    if not populated:
        return  # nowhere meaningful to go; stay put

    target = min(populated, key=lambda i: (abs(i - ws_id), i))
    subprocess.run(["hyprctl", "dispatch", "workspace", str(target)], check=False)


workspace_of_window = {
    c["address"].removeprefix("0x"): c["workspace"]["name"]
    for c in (hyprctl_json("clients") or [])
    if c.get("address") and c.get("workspace")
}


def window_left_the_active_workspace(address):
    return workspace_of_window.get(address) == active_workspace().get("name")


s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)
buf = b""
while True:
    chunk = s.recv(4096)
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        event = line.decode(errors="replace")
        name, _, payload = event.partition(">>")
        fields = payload.split(",")
        address = fields[0]
        # openwindow>>ADDRESS,WORKSPACENAME,CLASS,TITLE
        # movewindow>>ADDRESS,WORKSPACENAME
        # closewindow>>ADDRESS
        if name == "openwindow":
            workspace_of_window[address] = fields[1]
        elif name == "movewindow":
            came_from_here = window_left_the_active_workspace(address)
            workspace_of_window[address] = fields[1]
            if came_from_here:
                jump_back_if_empty()
        elif name == "closewindow":
            came_from_here = window_left_the_active_workspace(address)
            workspace_of_window.pop(address, None)
            if came_from_here:
                jump_back_if_empty()
