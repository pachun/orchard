#!/bin/sh
# Four-state app toggle, generalized from the original
# bluebubbles-toggle. Use as the on-click / keybind handler for any
# app you treat as a window you bring forward, hide, and bring back
# — rather than launching a fresh instance every time.
#
#   1. Not running                  → launch ($@ exec'd verbatim)
#   2. Running, currently focused   → minimize: stash to a special
#                                     workspace named special:<class>
#                                     (Hyprland's scratchpad — the
#                                     equivalent of macOS minimize)
#   3. Running, on special:<class>  → restore: move back to the
#                                     current workspace if it's empty,
#                                     otherwise the lowest-numbered
#                                     empty workspace (matches the
#                                     global `match:class .*, workspace
#                                     empty` rule in hyprland.conf so
#                                     restored windows land where new
#                                     launches would)
#   4. Running, on a regular ws     → focus + raise
#
# Multi-window apps: minimize hides only the focused window of the
# class; restore brings back the most-recently-stashed window. So
# repeated invocations on a multi-window app (e.g. ghostty) hide
# them one at a time and then unhide them, matching the macOS
# Cmd+H per-window feel.
#
# --here changes state 3: bring the window back to the workspace you are on,
# rather than to an empty one. For an app that belongs beside what you are doing
# — a calculator, a file manager — being restored to a desktop of its own is the
# wrong answer. Pair it with `windowrule = workspace unset` on the same class, so
# the launch and the restore agree; without the rule, the first launch would
# still be sent away by the global empty-workspace rule.
#
# --name "Friendly Name" announces the launch: for the seconds between the
# keypress and the first window of a slow-starting app (Beekeeper Studio takes
# five), "Opening Friendly Name…" holds the bar's clock slot, silently, and is
# dismissed the moment the window appears. Only state 1 announces — focusing,
# stashing, and restoring are already their own instant feedback.
#
# Usage: focus-or-launch [--here] [--name <friendly-name>] <window-class> <command...>
set -eu

restore_here=false
launch_name=''
while [ "$#" -gt 0 ]; do
    case "$1" in
        --here) restore_here=true; shift ;;
        --name) launch_name="$2"; shift 2 ;;
        *) break ;;
    esac
done

if [ "$#" -lt 2 ]; then
    echo "usage: $(basename "$0") [--here] [--name <friendly-name>] <window-class> <command...>" >&2
    exit 2
fi

class="$1"
shift
special="special:$class"

# The announcement outlives this script (state 1 ends in exec), so it runs as a
# backgrounded watcher: put up the notice, poll for the window, take the notice
# down. The timeout is the fallback for a launch that never produces a window —
# wrong class, crashed app — so the bar doesn't hold "Opening…" forever.
slowest_expected_launch_ms=15000
polls_per_second=10

announce_launch_until_window_appears() {
    notice_id="$(notify-send -p -t "$slowest_expected_launch_ms" \
        -h boolean:x-orchard-silent:true "Opening $launch_name…" 2>/dev/null)" || return 0
    polls_remaining=$((slowest_expected_launch_ms / 1000 * polls_per_second))
    while [ "$polls_remaining" -gt 0 ]; do
        if hyprctl clients -j | jq -e --arg cls "$class" 'any(.[]; .class == $cls)' >/dev/null; then
            break
        fi
        sleep 0.1
        polls_remaining=$((polls_remaining - 1))
    done
    gdbus call --session \
        --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.CloseNotification \
        "$notice_id" >/dev/null 2>&1 || true
}

clients="$(hyprctl clients -j)"

# State 3 check first — does this app have a window stashed in its
# scratchpad? If so, we're restoring regardless of focus state.
stashed_addr="$(printf '%s' "$clients" \
    | jq -r --arg ws "$special" '.[] | select(.workspace.name == $ws) | .address' \
    | head -1)"

if [ -n "$stashed_addr" ]; then
    current_ws="$(hyprctl activeworkspace -j | jq -r '.id')"
    current_count="$(hyprctl activeworkspace -j | jq -r '.windows')"
    if [ "$restore_here" = true ]; then
        target="$current_ws"
    elif [ "$current_count" = "0" ]; then
        target="$current_ws"
    else
        # Lowest non-special workspace not currently in use. Mirrors
        # the global "new windows land on empty workspace" rule.
        used="$(hyprctl workspaces -j | jq '[.[].id | select(. > 0)]')"
        target=1
        while printf '%s' "$used" | jq -e --argjson n "$target" 'index($n)' >/dev/null; do
            target=$((target + 1))
        done
    fi
    hyprctl dispatch movetoworkspace "$target,address:$stashed_addr"
    exit 0
fi

# Any visible (non-special) window of this class? We filter out
# special workspaces explicitly so a future stashed-window-but-also-
# visible-window scenario (multi-window app, partial minimize) still
# dispatches sanely.
visible_addr="$(printf '%s' "$clients" \
    | jq -r --arg cls "$class" \
        '.[] | select(.class == $cls) | select(.workspace.name | startswith("special:") | not) | .address' \
    | head -1)"

if [ -z "$visible_addr" ]; then
    # State 1: not running anywhere — launch.
    if [ -n "$launch_name" ]; then
        announce_launch_until_window_appears &
    fi
    exec "$@"
fi

focused_addr="$(hyprctl activewindow -j | jq -r '.address // ""')"
focused_class="$(hyprctl activewindow -j | jq -r '.class // ""')"

if [ "$focused_class" = "$class" ]; then
    # State 2: focused — stash the *focused* window. If there are
    # multiple windows of this class, this only minimizes the one
    # the user is looking at, leaving the others alone.
    # `movetoworkspacesilent` keeps the user's view on the current
    # workspace instead of following the window into the scratchpad.
    hyprctl dispatch movetoworkspacesilent "$special,address:$focused_addr"
else
    # State 4: visible elsewhere — focus + raise. `class:` selector
    # picks the most-recently-focused window of the class, which is
    # the right "bring it back" semantic for multi-window apps.
    hyprctl dispatch focuswindow "class:$class"
fi
