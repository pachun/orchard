#!/bin/sh
set -eu

snapshot=$(sed -n 's|^Server = https://archive\.archlinux\.org/repos/\([0-9/]*\)/\$repo.*|\1|p' /etc/pacman.d/mirrorlist 2>/dev/null | head -n1)

if [ -n "$snapshot" ]; then
    printf 'Batched, packages as of %s\n' "$(date -d "$(printf '%s' "$snapshot" | tr / -)" '+%-d %b')"
else
    echo Edge
fi
