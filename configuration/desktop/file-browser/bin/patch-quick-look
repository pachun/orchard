#!/usr/bin/env python3
# Make Quick Look (sushi, Space in Nautilus) fit this desktop. Three of the
# files it ships inside a GResource are patched, and GLib's
# G_RESOURCE_OVERLAYS is what substitutes a file for a path in that resource
# (the file-browser installer points it at the copies written here).
#
# The window's size. sushi caps a preview at half the monitor; a preview is
# the thing you are looking at, so it gets most of the screen instead. The
# client-side shadow goes too (the desktop draws no drop shadows anywhere,
# and the shadow's extra buffer area is what the compositor shows for a
# frame before the window geometry lands). The two header-bar buttons leave
# the keyboard focus chain: the window opens from a key press, so GTK shows
# keyboard focus, and the first button grew a focus ring the moment the
# window appeared.
#
# Transparency. The image viewer paints the picture straight onto the window
# background, so a PNG with a transparent background looks like it has a
# solid one — the window's — and there is no telling the two apart. An image
# with an alpha channel now sits on a checkerboard, the way every image
# editor shows transparency; an opaque image is left alone.
#
# Rendered from the installed sushi on every configure run so an upstream
# change to the rest of each file is picked up; if the text a patch replaces
# ever moves, this fails loudly rather than shipping a stale copy.
from pathlib import Path

import gi

from gi.repository import Gio

gresource = "/usr/share/sushi/org.gnome.NautilusPreviewer.src.gresource"
mainWindowResource = "/org/gnome/NautilusPreviewer/js/core/mainWindow.js"
mainWindowLayoutResource = "/org/gnome/NautilusPreviewer/ui/mainWindow.ui"
imageViewerResource = "/org/gnome/NautilusPreviewer/js/viewers/image.js"
patchedDirectory = Path.home() / ".config/sushi"
monitorFraction = 0.85

upstreamSizeCap = """const WINDOW_MAX_PERCENT_W = 0.5;
const WINDOW_MAX_PERCENT_H = 0.5;
"""
replacementSizeCap = f"""const WINDOW_MAX_PERCENT_W = {monitorFraction};
const WINDOW_MAX_PERCENT_H = {monitorFraction};
"""
windowConstructed = """        super({
            application,
            widthRequest: MIN_WIDTH,
            heightRequest: MIN_HEIGHT,
            defaultWidth: MIN_WIDTH,
            defaultHeight: MIN_HEIGHT,
        });
"""
flatDecoration = windowConstructed + """
        const flatDecoration = new Gtk.CssProvider();
        flatDecoration.load_from_string('window.csd { box-shadow: none; margin: 0; }');
        Gtk.StyleContext.add_provider_for_display(this.get_display(), flatDecoration,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
"""

fullscreenButton = '<object class="GtkButton" id="fullscreen_button">'
openButton = '<object class="GtkButton"><property name="icon-name">detach-symbolic</property>'
unfocusable = '<property name="focusable">false</property>'

frameDelayConstant = "const MICROS_PER_MILLIS = 1_000;\n"
checkerboardStyle = frameDelayConstant + """
const CHECKERBOARD_SQUARE_SIZE = 8;
const CHECKERBOARD_LIGHT_GRAY = '#999999';
const CHECKERBOARD_DARK_GRAY = '#666666';
const TRANSPARENT_IMAGE_CLASS = 'transparent-image';

let checkerboardStyle = null;
const showCheckerboardUnderTransparentImages = display => {
    if (checkerboardStyle)
        return;
    const square = CHECKERBOARD_SQUARE_SIZE;
    const darkCorners = `${CHECKERBOARD_DARK_GRAY} 25%, transparent 25%, transparent 75%, ${CHECKERBOARD_DARK_GRAY} 75%`;
    checkerboardStyle = new Gtk.CssProvider();
    checkerboardStyle.load_from_string(`
        picture.${TRANSPARENT_IMAGE_CLASS} {
            background-color: ${CHECKERBOARD_LIGHT_GRAY};
            background-image: linear-gradient(45deg, ${darkCorners}), linear-gradient(45deg, ${darkCorners});
            background-size: ${square * 2}px ${square * 2}px;
            background-position: 0 0, ${square}px ${square}px;
        }`);
    Gtk.StyleContext.add_provider_for_display(display, checkerboardStyle,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION);
};
"""
frameDecoded = "        const frame = await this._image.next_frame_async(this.cancellable);\n"
checkerboardUnderTransparentFrame = frameDecoded + """        if (Gly.MemoryFormat.has_alpha(frame.get_memory_format())) {
            showCheckerboardUnderTransparentImages(this.get_display());
            this.add_css_class(TRANSPARENT_IMAGE_CLASS);
        }
"""


def sourceOf(resourcePath):
    return resource.lookup_data(resourcePath, Gio.ResourceLookupFlags.NONE).get_data().decode()


def requireAnchors(resourcePath, source, anchors):
    for anchor in anchors:
        if anchor not in source:
            raise SystemExit(f"sushi's {resourcePath} no longer contains the expected text:\n{anchor}")


def replaced(source, replacements):
    for anchor, replacement in replacements.items():
        source = source.replace(anchor, replacement, 1)
    return source


def patch(resourcePath, replacements):
    source = sourceOf(resourcePath)
    requireAnchors(resourcePath, source, replacements)
    target = patchedDirectory / Path(resourcePath).name
    target.write_text(replaced(source, replacements))
    print(f"wrote {target}")


resource = Gio.Resource.load(gresource)
patchedDirectory.mkdir(parents=True, exist_ok=True)

patch(mainWindowResource, {
    upstreamSizeCap: replacementSizeCap,
    windowConstructed: flatDecoration,
})
patch(mainWindowLayoutResource, {
    fullscreenButton: fullscreenButton + unfocusable,
    openButton: '<object class="GtkButton">' + unfocusable + '<property name="icon-name">detach-symbolic</property>',
})
patch(imageViewerResource, {
    frameDelayConstant: checkerboardStyle,
    frameDecoded: checkerboardUnderTransparentFrame,
})
