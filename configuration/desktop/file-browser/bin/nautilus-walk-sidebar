#!/usr/bin/env python3
# Move the focused Nautilus window's sidebar highlight one row down or up,
# opening that place. GTK4 exposes the sidebar rows over the accessibility
# bus but refuses focus grabs and offers no activate action for them, and
# Nautilus has no keyboard shortcut or D-Bus call that navigates an
# existing window — so this reads the target row's position from the
# accessibility bus and clicks it, putting the pointer back afterward.
import json
import subprocess
import sys
import time

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi

nautilusClass = "org.gnome.Nautilus"
leftClick = "0xC0"
clickSettleSeconds = 0.05


def hyprctl(*args):
    return json.loads(subprocess.check_output(["hyprctl", *args, "-j"]))


def dispatch(*args):
    subprocess.run(["hyprctl", "dispatch", *args], check=True, capture_output=True)


def children(node):
    return [node.get_child_at_index(i) for i in range(node.get_child_count())]


def descendants(node):
    for child in children(node):
        if child is None:
            continue
        yield child
        yield from descendants(child)


def nautilusApplication():
    desktop = Atspi.get_desktop(0)
    return next(app for app in children(desktop) if app.get_name() == nautilusClass)


def frameTitled(title):
    return next(frame for frame in children(nautilusApplication()) if frame.get_name() == title)


def sidebarRows(frame):
    sidebar = next(n for n in descendants(frame) if n.get_role_name() == "list" and n.get_name() == "Sidebar")
    rowList = next(n for n in descendants(sidebar) if n.get_role_name() == "list")
    return [row for row in children(rowList) if row.get_name() and row.get_extents(Atspi.CoordType.WINDOW).height > 0]


def isSelected(row):
    return row.get_state_set().contains(Atspi.StateType.SELECTED)


def rowToOpen(rows, direction):
    selectedIndex = next((i for i, row in enumerate(rows) if isSelected(row)), None)
    if selectedIndex is None:
        return rows[0] if direction == "down" else rows[-1]
    lastIndex = len(rows) - 1
    step = 1 if direction == "down" else -1
    return rows[min(max(selectedIndex + step, 0), lastIndex)]


def clickRow(window, row):
    extents = row.get_extents(Atspi.CoordType.WINDOW)
    windowX, windowY = window["at"]
    rowCenterX = windowX + extents.x + extents.width // 2
    rowCenterY = windowY + extents.y + extents.height // 2
    pointerBefore = subprocess.check_output(["hyprctl", "cursorpos"]).decode().replace(",", "").split()
    dispatch("movecursor", str(rowCenterX), str(rowCenterY))
    subprocess.run(["ydotool", "click", leftClick], check=True)
    time.sleep(clickSettleSeconds)
    dispatch("movecursor", *pointerBefore)


direction = sys.argv[1] if len(sys.argv) > 1 else "down"
window = hyprctl("activewindow")
if window.get("class") == nautilusClass:
    rows = sidebarRows(frameTitled(window["title"]))
    clickRow(window, rowToOpen(rows, direction))
