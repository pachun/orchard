# BlueBubbles 2.0.0 beta, packaged to keep the window on Wayland.
#
# Why we package this ourselves instead of installing from the AUR:
#
# `bluebubbles-bin` is the stable release, and on Linux stable cannot paste
# text with ctrl+V at all — it fires an image clipboard read that starves
# Flutter's text read, and GTK drops whichever request arrives second. Fixed
# in 2.0.0. https://github.com/BlueBubblesApp/bluebubbles-app/issues/3089
#
# The AUR's two beta packages (`bluebubbles-beta-bin`, `bluebubbles-desktop-app`)
# do carry the fix, but both export GDK_BACKEND=x11 in their launcher and both
# rename the binary. The x11 export drops the window onto XWayland, where
# Hyprland renders it at logical size and upscales it — soft text on a 2880x1800
# display, for a chat app you read all day. The rename changes the window class,
# which is what hyprland.conf's scratchpad windowrule, launch-hidden and
# orchard-notifications all key on. Upstream's tarball sets no GDK_BACKEND and
# ships the binary as `bluebubbles`, so packaging it directly keeps the window
# native and the class unchanged, and none of the desktop config has to move.
#
# When 2.0.0 reaches stable, this whole directory's PKGBUILD goes away and
# install.sh goes back to `yay -S --needed --noconfirm bluebubbles-bin`.
pkgname=bluebubbles-beta-wayland
_pkgname=BlueBubbles
pkgver=2.0.0+87_desktop_b.3
# The release tag carries a literal `+`, which pkgver may not, and which has to
# stay percent-encoded to survive the download URL.
_tagver="2.0.0%2B87-desktop-b.3"
pkgrel=1
pkgdesc="BlueBubbles desktop client, 2.0.0 beta (prebuilt, native Wayland)"
arch=(
    'aarch64'
    'x86_64'
)
url="https://bluebubbles.app/"
_ghurl="https://github.com/BlueBubblesApp/bluebubbles-app"
license=('Apache-2.0')
provides=("bluebubbles=${pkgver}")
conflicts=(
    'bluebubbles'
    'bluebubbles-bin'
    'bluebubbles-beta-bin'
    'bluebubbles-desktop-app'
)
depends=(
    'webkit2gtk-4.1'
    'gdk-pixbuf2'
    'mpv'
    'libdbusmenu-glib'
    'libnotify'
    'libappindicator-gtk3'
    'gtk3'
)
options=(
    '!emptydirs'
    # Upstream ships a stripped release binary; without this makepkg still
    # builds an empty -debug package alongside, which --install would pull in.
    '!debug'
)
source_aarch64=("bluebubbles-${pkgver}-aarch64.tar.gz::${_ghurl}/releases/download/v${_tagver}/bluebubbles-linux-aarch64.tar.gz")
source_x86_64=("bluebubbles-${pkgver}-x86_64.tar.gz::${_ghurl}/releases/download/v${_tagver}/bluebubbles-linux-x86_64.tar.gz")
sha256sums_aarch64=('1d4abfe32c9451ab6b8a7b008c607776953f8ced842efe99e89990a47c2b6476')
sha256sums_x86_64=('49f592658692d68b6447edb9cbdeb39d33ca74e4b12d351ad5d811e4b3b2ed4c')

package() {
    # The launcher deliberately sets no GDK_BACKEND: with it unset the app
    # negotiates Wayland and Hyprland reports xwayland=false. Flutter takes the
    # window class from the executable name, so exec'ing a binary still called
    # `bluebubbles` is what keeps the class `bluebubbles`.
    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/bluebubbles" <<'LAUNCHER'
#!/bin/bash
set -o pipefail
application_directory="/usr/lib/bluebubbles"
export LD_LIBRARY_PATH="${application_directory}/lib:${LD_LIBRARY_PATH:-}"
cd "${application_directory}" || { echo "Failed to change directory to ${application_directory}"; exit 1; }
exec "${application_directory}/bluebubbles" "$@"
LAUNCHER

    install -Dm755 "${srcdir}/bluebubbles" -t "${pkgdir}/usr/lib/bluebubbles"
    cp -a "${srcdir}/"{data,lib} "${pkgdir}/usr/lib/bluebubbles"
    install -Dm644 "${srcdir}/data/flutter_assets/assets/icon/icon.png" \
        "${pkgdir}/usr/share/pixmaps/bluebubbles.png"

    # media_kit links against libmpv.so.1; Arch's mpv ships libmpv.so.2.
    ln -sf "/usr/lib/libmpv.so" "${pkgdir}/usr/lib/libmpv.so.1"

    # orchard-notifications reads the class off this Exec line, and
    # focus-or-launch is handed the same name — keep them saying `bluebubbles`.
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/bluebubbles.desktop" <<'DESKTOP'
[Desktop Entry]
Version=1.0
Type=Application
Name=BlueBubbles
Comment=A cross-platform app ecosystem, bringing iMessage to Android, PC (Windows, Linux, & even macOS), and Web!
Exec=bluebubbles %U
Icon=bluebubbles
Terminal=false
StartupNotify=false
Categories=Network;
DESKTOP
}
