#!/usr/bin/env python3
"""Bring a tmux session to the front — the click action on a "Claude finished"
notification.

Claude runs inside tmux, one session per task, and usually only one of them is
on screen at a time. When one you aren't watching finishes, its notification
names the session; clicking it lands you there.

"There" means: if some terminal is already showing that session, focus it;
otherwise point the terminal you were last using at it; and if nothing is
attached at all, open a fresh terminal on it. The notification daemon that runs
this is not itself inside tmux, so every tmux call reaches the server over its
default socket rather than through $TMUX.
"""
import json
import os
import subprocess
import sys
from collections import namedtuple

Client = namedtuple("Client", "tty pid session last_activity")


def tmux(*args):
    return subprocess.run(
        ["tmux", *args], capture_output=True, text=True, env={**os.environ, "TMUX": ""}
    )


def session_exists(session):
    return tmux("has-session", "-t", f"={session}").returncode == 0


def attached_clients():
    fields = "#{client_tty}\t#{client_pid}\t#{client_session}\t#{client_activity}"
    listing = tmux("list-clients", "-F", fields).stdout
    clients = []
    for line in listing.splitlines():
        tty, pid, session, activity = line.split("\t")
        clients.append(Client(tty, int(pid), session, int(activity)))
    return clients


def ghostty_window_by_pid():
    listing = subprocess.run(
        ["hyprctl", "clients", "-j"], capture_output=True, text=True
    ).stdout
    return {
        window["pid"]: window["address"]
        for window in json.loads(listing)
        if "ghostty" in window.get("class", "").lower()
    }


def parent_of(pid):
    try:
        with open(f"/proc/{pid}/status") as status:
            for line in status:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except OSError:
        pass
    return None


def window_hosting(client_pid, window_by_pid):
    """The ghostty window a tmux client is running inside — found by walking up
    from the client process to whichever ancestor is a ghostty window."""
    pid = client_pid
    while pid and pid > 1:
        if pid in window_by_pid:
            return window_by_pid[pid]
        pid = parent_of(pid)
    return None


def focus(window_address):
    subprocess.run(
        ["hyprctl", "dispatch", "focuswindow", f"address:{window_address}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def open_session(session):
    if not session_exists(session):
        return

    windows = ghostty_window_by_pid()
    clients = attached_clients()

    already_showing_it = [client for client in clients if client.session == session]
    if already_showing_it:
        client = already_showing_it[0]
    elif clients:
        client = max(clients, key=lambda c: c.last_activity)
        tmux("switch-client", "-c", client.tty, "-t", f"={session}")
    else:
        subprocess.Popen(
            ["ghostty", "-e", "tmux", "attach", "-t", f"={session}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return

    window = window_hosting(client.pid, windows)
    if window:
        focus(window)


if __name__ == "__main__":
    open_session(sys.argv[1] if len(sys.argv) > 1 else "")
