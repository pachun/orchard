#!/bin/sh
# updates-now: pending pacman + AUR package updates and available device
# firmware, as one JSON blob for the bar. Empty (effectively hidden) when
# there's nothing to do, when offline, or while the very first refresh is
# still running. Package count is exact; firmware is a boolean (present or
# not). waybar-hidden-during-notifications runs this on a schedule (and on
# SIGRTMIN+10) and owns the bar slot; clicking the badge runs system-update,
# which applies both.
#
# Architecture: stale-while-revalidate.
#   - Waybar polls every minute; the script reads /tmp/waybar-updates.cache
#     and prints it in <10ms.
#   - If the cache is older than $MAX_AGE, a background refresh kicks
#     off (checkupdates + yay -Qua + fwupdmgr get-updates, ~1-2s total)
#     and calls refresh-updates-badge when done, so the bar reruns this
#     and shows the new count at once.
#   - A flag file at /tmp/waybar-updates.refreshing dedupes concurrent
#     refresh runs. If the flag's older than $LOCK_TTL the prior runner
#     was killed (e.g. a waybar restart took out the subshell with
#     SIGKILL before its trap could fire) — we ignore the stale lock
#     and start a new refresh.
#
# Why we always emit JSON: waybar treats *no output* on a custom
# module as "no change, keep the previous value" — so a successful
# system-update that wipes the cache would still leave the badge
# rendered until the next 60s poll. Emitting {"text":""} for the
# hidden state forces waybar to re-render an empty module immediately.
#
# system-update wipes the cache + calls refresh-updates-badge after a
# successful upgrade so the badge clears instantly rather than waiting on
# the next refresh window.
#
# Phosphor download-simple (U+E20C) is the entire visible text — the
# count goes in the tooltip, not the bar, so it doesn't visually collide
# with neighboring numeric modules.

CACHE=/tmp/waybar-updates.cache
LOCK=/tmp/waybar-updates.refreshing
MAX_AGE=900   # 15 min cache TTL
LOCK_TTL=60   # any lock older than this is presumed orphaned
EMPTY='{"text":""}'

# Bail when offline. nmcli's STATE is 'connected' when any active
# connection is up (wifi or wired). Reads NM's cached state, no probe.
nm_state=$(nmcli -t -f STATE general 2>/dev/null)
if [ "$nm_state" != "connected" ]; then
    printf '%s\n' "$EMPTY"
    exit 0
fi

lock_alive=0
if [ -f "$LOCK" ]; then
    lock_age=$(($(date +%s) - $(stat -c %Y "$LOCK" 2>/dev/null || echo 0)))
    [ "$lock_age" -lt "$LOCK_TTL" ] && lock_alive=1
fi

now=$(date +%s)
mtime=0
[ -f "$CACHE" ] && mtime=$(stat -c %Y "$CACHE" 2>/dev/null || echo 0)
cache_stale=1
[ -f "$CACHE" ] && [ $((now - mtime)) -lt "$MAX_AGE" ] && cache_stale=0

if [ "$cache_stale" -eq 1 ] && [ "$lock_alive" -eq 0 ]; then
    (
        touch "$LOCK"
        trap 'rm -f "$LOCK"' EXIT
        repo=$(checkupdates 2>/dev/null | wc -l)
        aur=$(timeout 30 yay -Qua 2>/dev/null | wc -l)
        # fwupdmgr get-updates exits 0 only when a device has an update
        # waiting; 2 (or other non-zero) means nothing to flash.
        fw=0
        fwupdmgr get-updates >/dev/null 2>&1 && fw=1
        pkgs=$((repo + aur))
        if [ "$pkgs" -eq 0 ] && [ "$fw" -eq 0 ]; then
            : > "$CACHE"
        elif [ "$pkgs" -eq 0 ]; then
            printf '{"text":"","tooltip":"Firmware update available"}\n' > "$CACHE"
        else
            tooltip="$pkgs pending — $repo from repos"
            [ "$aur" -gt 0 ] && tooltip="$tooltip, $aur from AUR"
            [ "$fw" -gt 0 ] && tooltip="$tooltip; firmware update available"
            printf '{"text":"","tooltip":"%s"}\n' \
                "$tooltip" > "$CACHE"
        fi
        "$HOME/.local/bin/refresh-updates-badge"
    ) >/dev/null 2>&1 &
fi

# Output JSON in all branches: cache content if non-empty, else
# explicit empty so waybar re-renders blank instead of holding on
# to the previous badge.
if [ -s "$CACHE" ]; then
    cat "$CACHE"
else
    printf '%s\n' "$EMPTY"
fi
exit 0
