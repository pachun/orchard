#!/bin/sh
# waybar module: the volume, and a way into the output picker.
#
# The glyph is always a speaker — never the icon of whatever device happens to
# be playing. A bar icon has one degree of freedom and it should spend it on
# the thing that changes constantly and that you act on: the volume. So the
# speaker gains an arc as the level climbs (none / one / two) and wears a slash
# when muted. *Which* speaker the sound is going to is a slower-moving fact,
# and it belongs in the tooltip and the picker — click to open audio-menu.
#
# Deliberately no state class. An earlier version brightened the glyph while
# sound was going to an AirPlay speaker, and the effect was that one icon on
# the right of the bar looked a different colour from its neighbours — which
# reads as a rendering fault, not a signal. The ambient icons are a row of
# equals; which speaker is playing is in the tooltip.
#
# Runs continuously rather than on a poll: pactl subscribe wakes us on every
# volume, mute and default-sink change, so the icon tracks the volume keys
# exactly instead of lagging up to a second behind them. The sink's *label* is
# only recomputed when the default sink actually changes — that costs a full
# `pactl list sinks`, and re-running it on every volume keypress would be
# wasteful.
set -eu

. "$HOME/.local/bin/_audio-sinks"

known_sink=""
label=""

emit() {
    sink=$(audio_current_sink)
    if [ -z "$sink" ]; then
        printf '{"text": "%s", "tooltip": "No audio output"}\n' "$ICON_SPEAKER_MUTED"
        return
    fi

    if [ "$sink" != "$known_sink" ]; then
        label=$(audio_outputs | awk -F'\t' -v n="$sink" '$1 == n { print $2; exit }')
        [ -n "$label" ] || label="Unknown"
        known_sink=$sink
    fi

    printf '{"text": "%s", "tooltip": "Output: %s"}\n' \
        "$(audio_volume_icon)" "$label"
}

# `pactl subscribe` outlives this script if we don't kill it, and it holds one of
# PulseAudio's client slots while it does. There are sixty-four. waybar restarts
# on every theme switch, so every theme switch leaked one — and when the last
# slot went, PulseAudio began refusing new clients, and Pulse-based apps could no
# longer reach it while wpctl-based ones kept working fine (wpctl speaks to
# PipeWire directly and never touches the Pulse layer).
# That is a very confusing way to lose your volume keys, and it took a while to
# find, so: two defences, because one is not enough.
#
# The trap covers a clean exit and a SIGTERM. The pidfile covers SIGKILL, where
# no trap runs at all — the next instance reaps whatever the last one abandoned,
# so at most one subscriber can ever be orphaned rather than one per restart.
#
# The subscriber runs through a fifo rather than a pipeline because a pipeline
# gives us no pid to kill. The fifo is unlinked the moment it's open: the fd
# outlives the name, and nothing is left in the runtime directory.
subscriber=""
subscriber_pid_file="${XDG_RUNTIME_DIR:-/tmp}/waybar-audio.subscriber"

stop_subscriber() {
    [ -n "$subscriber" ] && kill "$subscriber" 2>/dev/null
    rm -f "$subscriber_pid_file"
    return 0
}

reap_abandoned_subscriber() {
    abandoned=$(cat "$subscriber_pid_file" 2>/dev/null) || return 0
    case "$abandoned" in '' | *[!0-9]*) return 0 ;; esac
    # Pids get recycled, so only kill it if it is still what we left behind.
    if grep -qa '^pactl$' "/proc/$abandoned/comm" 2>/dev/null; then
        kill "$abandoned" 2>/dev/null
    fi
    return 0
}

reap_abandoned_subscriber
trap stop_subscriber EXIT HUP INT TERM

events="${XDG_RUNTIME_DIR:-/tmp}/waybar-audio.events.$$"
mkfifo "$events"
pactl subscribe >"$events" 2>/dev/null &
subscriber=$!
printf '%s\n' "$subscriber" > "$subscriber_pid_file"
exec 3< "$events"
rm -f "$events"

emit
while IFS= read -r event <&3; do
    case "$event" in
        *"on sink"*|*"on server"*) emit ;;
    esac
done
