#!/bin/sh
# waybar custom/bluetooth status. Always emits something (stays visible
# in the bar at all times per design — never blanks).
#
# Steady-state output:
#   service down / no adapter   → bluetooth-slash, "off" tooltip
#   on, no devices connected    → bluetooth,       "no connections"
#   on, ≥1 device connected     → bluetooth-conn., device list
#
# The connection state is carried by the *glyph*, not by colour. Every
# ambient icon on the right of the bar is the same colour by design: one
# icon rendering brighter than its neighbours reads as a fault rather than
# as a signal, whatever it was meant to say. bluetooth-connected is visibly
# a different mark from bluetooth, which is signal enough, and the device
# name is in the tooltip. The `connected` class is still emitted — it's true,
# and a theme could use it — but nothing styles it.
#
# Active scan: when /tmp/bluetooth-scanning exists (dropped by
# bluetooth-menu under a trap on auto-scan start, removed on end),
# we append "scanning" to the class. CSS animates opacity on
# .scanning so the existing bluetooth glyph itself pulses — no
# separate module, no layout shift, scanning is just a *state* of
# the icon you already know. Opacity, not colour, so it stays within
# the rule above.
#
# Phosphor codepoints:
#   bluetooth            U+E0DA
#   bluetooth-connected  U+E0DC
#   bluetooth-slash      U+E0DE
#
# Refresh: bluetooth-menu sends SIGRTMIN+11 after any action that
# changes connection state, including scan start/stop. The 30s
# polling interval in waybar config is the steady-state safety
# net, not the primary refresh path.

ICON_OFF=$(printf      '\356\203\236')   # U+E0DE bluetooth-slash
ICON_ON=$(printf       '\356\203\232')   # U+E0DA bluetooth
ICON_CONNECTED=$(printf '\356\203\234')  # U+E0DC bluetooth-connected

emit() {
    # $1 = icon, $2 = tooltip, $3 = base class (may be empty).
    # Appends "scanning" to the class if the scan indicator is up.
    icon=$1; tooltip=$2; class=$3
    if [ -f /tmp/bluetooth-scanning ]; then
        if [ -n "$class" ]; then
            class="$class scanning"
        else
            class="scanning"
        fi
    fi
    if [ -n "$class" ]; then
        printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$icon" "$class" "$tooltip"
    else
        printf '{"text":"%s","tooltip":"%s"}\n' "$icon" "$tooltip"
    fi
}

if ! command -v bluetoothctl >/dev/null 2>&1; then
    emit "$ICON_OFF" "Bluetooth unavailable" ""
    exit 0
fi

powered=$(bluetoothctl show 2>/dev/null | awk -F': *' '/Powered:/ {print $2; exit}')

if [ -z "$powered" ]; then
    # Adapter or service missing.
    emit "$ICON_OFF" "Bluetooth service inactive" ""
    exit 0
fi

if [ "$powered" != "yes" ]; then
    emit "$ICON_OFF" "Bluetooth off" ""
    exit 0
fi

# On — count + name connected devices for the tooltip.
connected_lines=$(bluetoothctl devices Connected 2>/dev/null)
count=$(printf '%s' "$connected_lines" | grep -c .)

if [ "$count" -eq 0 ]; then
    emit "$ICON_ON" "Bluetooth on, nothing connected" ""
else
    # Tooltip: "Connected: Name1, Name2"
    names=$(printf '%s\n' "$connected_lines" | sed 's/^Device [^ ]* //' | paste -sd ", " -)
    emit "$ICON_CONNECTED" "Connected: $names" "connected"
fi
