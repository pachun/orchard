#!/bin/sh
# waybar module: the do-not-disturb bell.
#
# Reads the daemon's state file rather than asking it, so the bar never blocks
# on a D-Bus round trip; the file is the daemon's own record of whether it's
# swallowing notifications.
set -eu

LINGER_SECONDS=30
TOGGLE_TIME_FILE=/tmp/dnd-toggle-time
DO_NOT_DISTURB="${XDG_RUNTIME_DIR:-/tmp}/orchard/do-not-disturb"

if [ -e "$DO_NOT_DISTURB" ]; then
    printf '{"text":"","tooltip":"do not disturb (on)","class":"active"}\n'
    exit 0
fi

now=$(date +%s)
last_toggle=$(cat "$TOGGLE_TIME_FILE" 2>/dev/null || echo 0)
if [ $((now - last_toggle)) -lt "$LINGER_SECONDS" ]; then
    printf '{"text":"","tooltip":"do not disturb (off)","class":"linger"}\n'
else
    printf '{"text":"","tooltip":""}\n'
fi
