#!/bin/sh
# Emits JSON for waybar's custom/recording module: Phosphor record glyph
# plus elapsed time while wf-recorder runs, in the theme's red with a slow
# pulse (style.css); empty text otherwise so the module is invisible.
#
# Icon (Phosphor fill):
#   record  U+E3EE  \356\217\256
recorder_pid=$(pgrep -x wf-recorder | head -1)
if [ -n "$recorder_pid" ]; then
    icon=$(printf '\356\217\256')
    elapsed_seconds=$(ps -o etimes= -p "$recorder_pid" | tr -d ' ')
    elapsed=$(printf '%d:%02d' $((elapsed_seconds / 60)) $((elapsed_seconds % 60)))
    printf '{"text":"%s %s","class":"recording","tooltip":"Recording — click to stop"}\n' "$icon" "$elapsed"
else
    printf '{"text":""}\n'
fi
