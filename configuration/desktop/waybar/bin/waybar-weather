#!/bin/bash
# Waybar weather module: fetches current condition + temperature +
# sun times from wttr.in (location auto-detected from IP, units forced
# to US/Fahrenheit) and emits waybar JSON — "<icon> <temp>" as the text,
# the next sunrise/sunset as the tooltip. Requires bash for the
# $'\UXXXXXXXX' escape sequences used to embed the supplementary-plane
# MDI weather glyphs from Symbols Nerd Font Mono (same icon family as
# battery / wifi — outlined silhouette with state shown by partial
# fills inside).
#
# Resilience: every successful fetch caches its output. On network
# failure we emit the cached value instead of "--", so the bar stays
# populated through brief outages and post-sleep wifi reconnects.
# A NetworkManager dispatcher (99-waybar-weather-refresh) sends
# SIGRTMIN+9 to waybar on interface up so the next refresh happens
# within seconds of reconnect rather than up to 10 minutes later.
set -eu

# .json suffix keeps a cache written by the old plain-text version of
# this script from being replayed as (invalid) waybar JSON.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-weather.json"
mkdir -p "$(dirname "$CACHE")"

emit_cached() {
    if [ -s "$CACHE" ]; then
        cat "$CACHE"
    else
        printf '%s\n' '{"text": "--"}'
    fi
}

raw=$(curl -s --max-time 5 'https://wttr.in/?u&format=%C|%t|%S|%s' 2>/dev/null || true)

if [ -z "$raw" ] || echo "$raw" | grep -qiE 'unknown|error|<html'; then
    emit_cached
    exit 0
fi

IFS='|' read -r condition temp sunrise sunset <<<"$raw"
condition=${condition%"${condition##*[![:space:]]}"}    # wttr.in pads %C with a trailing space
temp=${temp#+}    # strip the leading "+" from "+71°F"

now=$(date +%s)
sunrise_epoch=$(date -d "$sunrise" +%s 2>/dev/null || true)
sunset_epoch=$(date -d "$sunset" +%s 2>/dev/null || true)
have_sun_times=0
if [ -n "$sunrise_epoch" ] && [ -n "$sunset_epoch" ]; then
    have_sun_times=1
fi

# Use night glyph for clear-sky conditions outside daylight hours —
# by the real sun times when wttr.in gave us parseable ones, by fixed
# hours otherwise.
is_night=0
if [ "$have_sun_times" -eq 1 ]; then
    if [ "$now" -lt "$sunrise_epoch" ] || [ "$now" -ge "$sunset_epoch" ]; then
        is_night=1
    fi
else
    hour=$(date +%H)
    if [ "$hour" -lt 6 ] || [ "$hour" -ge 20 ]; then
        is_night=1
    fi
fi

# Phosphor weather glyphs (matches the rest of the right-side icon
# row's font for consistent stroke / baseline). Codepoints in the
# Unicode PUA range; bash $'\uXXXX' literals embed them inline.
icon=$'\ue472'  # sun
case "$condition" in
    Sunny|Clear)
        if [ "$is_night" -eq 1 ]; then icon=$'\ue58e'; else icon=$'\ue472'; fi
        ;;
    'Partly cloudy'|'Partly Cloudy')
        if [ "$is_night" -eq 1 ]; then icon=$'\ue53e'; else icon=$'\ue540'; fi
        ;;
    Cloudy|Overcast)              icon=$'\ue1aa' ;;
    Mist|Fog|Haze)                icon=$'\ue53c' ;;
    *Rain*|Drizzle*|*Shower*)     icon=$'\ue1b4' ;;
    *Snow*|Blizzard*|Sleet*)      icon=$'\ue1b8' ;;
    *Thunder*|*Storm*)            icon=$'\ue1b2' ;;
esac

# The tooltip shows whichever sun event comes next. wttr.in only gives
# today's times, so after sunset the tomorrow line reuses today's
# sunrise — off by the minute or two the sunrise drifts per day.
tooltip=''
if [ "$have_sun_times" -eq 1 ]; then
    sunrise_pretty=$(date -d "@$sunrise_epoch" +'%-I:%M %p')
    sunset_pretty=$(date -d "@$sunset_epoch" +'%-I:%M %p')
    if [ "$now" -lt "$sunrise_epoch" ]; then
        tooltip="Sunrise $sunrise_pretty"
    elif [ "$now" -lt "$sunset_epoch" ]; then
        tooltip="Sunset $sunset_pretty"
    else
        tooltip="Sunrise $sunrise_pretty tomorrow"
    fi
fi

# Just the glyph: the temperature lives in the tooltip with the sun times.
# Wrapped in Pango markup to shift it down. Phosphor's weather glyphs (moon,
# sun, cloud-sun) occupy the upper half of their em-square, sitting visibly
# above the rest of the row. rise is in 1/10000 of em — negative pushes
# down; -1200 centers the glyph against the clock beside it. The custom
# module needs markup=pango (set in config.jsonc).
tooltip="$temp${tooltip:+ · $tooltip}"
text=$(printf '<span rise="-1200">%s</span>' "$icon")
jq -cn --arg text "$text" --arg tooltip "$tooltip" '{text: $text, tooltip: $tooltip}' | tee "$CACHE"
