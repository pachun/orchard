#!/usr/bin/env python3
"""The weather glyph beside the clock — and nothing, while a notification has
the centre.

Notifications take the clock's slot (see waybar-clock), and this module sits
right next to it, so it steps out of the way at the same moment with the same
fade: the message then owns the whole centre instead of shoving the glyph
aside. Both modules read the file orchard-notifications writes, so they agree
without talking to each other.

Continuous (no `interval` in config.jsonc) for the same reason as the clock —
a fade is frames at particular times. The weather itself is fetched by
weather-now every ten minutes on a background thread; a failed fetch (offline,
wttr.in down) retries after a minute while the last result holds the slot.
"""
import json
import os
import subprocess
import threading
import time
from pathlib import Path

SHOWING = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "orchard/notification.json"
FETCH = os.path.expanduser("~/.local/bin/weather-now")
REFRESH_SECONDS = 600
RETRY_SECONDS = 60
FADE_SECONDS = 0.25  # keep in step with the transition in waybar's style.css
SETTLE_SECONDS = 0.03
TICK_SECONDS = 0.05

weather = {"text": "", "tooltip": ""}


def say(text, tooltip="", classes=()):
    print(json.dumps({"text": text, "tooltip": tooltip, "class": list(classes)}), flush=True)


def notification_showing():
    try:
        return bool(json.loads(SHOWING.read_text()))
    except (FileNotFoundError, json.JSONDecodeError):
        return False


def keep_fresh():
    while True:
        try:
            result = subprocess.run([FETCH], capture_output=True, text=True, timeout=15)
            weather.update(json.loads(result.stdout))
            if not notification_showing():
                say(weather["text"], weather["tooltip"])
            delay = REFRESH_SECONDS
        except (OSError, ValueError, subprocess.TimeoutExpired):
            delay = RETRY_SECONDS
        time.sleep(delay)


def main():
    threading.Thread(target=keep_fresh, daemon=True).start()
    hidden = False
    while True:
        showing = notification_showing()
        if showing and not hidden:
            say(weather["text"], weather["tooltip"], ["faded"])
            time.sleep(FADE_SECONDS)
            say("", "", ["faded"])
            hidden = True
        elif not showing and hidden:
            # The clock is spending this quarter second fading the message out;
            # it swaps its text back only at the end. Putting the glyph back any
            # sooner lands it beside the still-visible message, and it jumps
            # left when the clock shrinks. Wait it out, then swap while both
            # are invisible and fade in together.
            time.sleep(FADE_SECONDS)
            say(weather["text"], weather["tooltip"], ["faded"])
            time.sleep(SETTLE_SECONDS)
            say(weather["text"], weather["tooltip"])
            hidden = False
        time.sleep(TICK_SECONDS)


if __name__ == "__main__":
    main()
