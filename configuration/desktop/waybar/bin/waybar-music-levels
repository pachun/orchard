#!/bin/sh
# Emits JSON for waybar's custom/music-levels module: a tiny live spectrum
# of whatever is playing. Real levels — cava runs an FFT over the PipeWire
# monitor and streams bar heights 0-7; awk draws them as block glyphs.
#
# The rendering borrows what makes the QML bar visualizers read well at
# this size without their canvas: monstercat smoothing so neighboring bars
# flow instead of jittering, a hair space between glyphs so bars read as
# discrete pills rather than a blob, and per-bar pango alpha so quiet bars
# sit back and loud ones come forward. Hides after ~2s of silence.
#
# Continuous exec: no signal key — waybar reads signal-without-interval as
# "run once per signal" and a looping script never draws. restart-interval
# revives this if cava dies, and doubles as the retry that brings the
# module up once cava is installed.
command -v cava >/dev/null 2>&1 || exit 0

cava_config="${XDG_RUNTIME_DIR:-/tmp}/waybar-music-levels.cava"
cat > "$cava_config" <<CONF
[general]
bars = 12
framerate = 24
[input]
method = pipewire
source = auto
[smoothing]
monstercat = 1
noise_reduction = 66
[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
CONF

silent_frames_before_hiding=48
exec cava -p "$cava_config" 2>/dev/null | awk -v hide_after="$silent_frames_before_hiding" '
BEGIN {
    split("▁ ▂ ▃ ▄ ▅ ▆ ▇ █", block_for_level, " ")
    hair_space = "\xe2\x80\x8a"
    silent_frames = hide_after; hidden = 1
}
{
    frame_total = 0
    bars = ""
    bar_count = split($0, level, ";")
    for (i = 1; i < bar_count; i++) {
        frame_total += level[i]
        faded_in = 45 + level[i] * 7
        bars = bars sprintf("<span alpha=\x27%d%%\x27>%s</span>", faded_in, block_for_level[level[i] + 1])
        if (i < bar_count - 1) bars = bars hair_space
    }
    if (frame_total == 0) {
        silent_frames++
        if (silent_frames >= hide_after && !hidden) { print "{\"text\":\"\"}"; hidden = 1; fflush() }
        next
    }
    silent_frames = 0; hidden = 0
    printf "{\"text\":\"%s\",\"tooltip\":\"Music levels\"}\n", bars
    fflush()
}'
