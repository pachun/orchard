// Bar layout for a machine with an unobstructed screen — i.e. the XPS, and
// anything that isn't an Apple laptop. Selected by waybar's install.sh and
// symlinked to ~/.config/waybar/layout.jsonc; config.jsonc includes that path.
//
// The clock sits dead centre, which is where a clock wants to be and where
// macOS can't put one, with the weather glyph just to its right and the
// updates badge, when there is one, just to its left. A notification takes
// the whole centre: badge and glyph fade out with the clock.
//
// Do-not-disturb moves to the head of the right-hand group. It lived in the
// centre on the Mac purely to sit beside the notch; with no notch to sit
// beside, the leftmost right-hand slot is the same idea — the most visible
// spot that isn't the clock.
{
    "modules-center": ["custom/updates", "custom/clock", "custom/weather"],

    // Battery last, hard against the screen edge. It's the one module you
    // look for rather than notice, so it earns the corner — the place your
    // eye can find without reading the bar.
    "modules-right": [
        "custom/dnd",
        "custom/recording",
        "custom/nordvpn",
        "custom/wifi-status",
        "custom/network",
        "custom/audio",
        "custom/bluetooth",
        "custom/claude-usage",
        "battery"
    ]
}
