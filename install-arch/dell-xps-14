#!/usr/bin/env bash
# install-arch/dell-xps-14 — bare Arch install for the Dell XPS 14
# (9440), run from the live Arch ISO after cloning orchard.
#
# BIOS prerequisites (set these first, or the install can't see the disk
# or won't boot): SATA Operation must be AHCI, not RAID; Secure Boot off.
#
# Owns the whole base install: partition the NVMe, pacstrap base, set
# timezone/locale/hostname, create a wheel user, mirror its password to
# root, install systemd-boot, enable NetworkManager, copy orchard into
# the new user's home. Configuration (dotfiles, desktop) is a separate
# phase the user runs after first login: configure.sh.
set -euo pipefail
shopt -s nullglob

require_root() {
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "install-arch must run as root" >&2
    exit 1
  fi
}

require_uefi() {
  if [ ! -d /sys/firmware/efi/efivars ]; then
    echo "Not booted in UEFI mode. Reboot the USB via its UEFI entry." >&2
    exit 1
  fi
}

detected_cpu_microcode() {
  case "$(sed -n 's/^vendor_id[[:space:]]*: //p' /proc/cpuinfo | head -1)" in
    GenuineIntel) echo intel-ucode ;;
    AuthenticAMD) echo amd-ucode ;;
    *)            echo "" ;;
  esac
}

collect_install_details() {
  read -rp "hostname: " INSTALL_HOSTNAME </dev/tty
  read -rp "username: " INSTALL_USERNAME </dev/tty

  while :; do
    read -srp "password: " INSTALL_USER_PASSWORD </dev/tty; echo
    read -srp "confirm password: " password_again </dev/tty; echo
    [ "$INSTALL_USER_PASSWORD" = "$password_again" ] && break
    echo "Passwords don't match. Try again."
  done
  unset password_again

  INSTALL_MICROCODE="$(detected_cpu_microcode)"
  export INSTALL_HOSTNAME INSTALL_USERNAME INSTALL_USER_PASSWORD INSTALL_MICROCODE
}

pick_os_drive() {
  mapfile -t nvmes < <(lsblk -d -p -n -o NAME,TRAN | awk '$2 == "nvme" {print $1}')

  if [ "${#nvmes[@]}" -eq 0 ]; then
    echo "No NVMe drive found. In BIOS, set SATA Operation to AHCI." >&2
    exit 1
  fi

  if [ "${#nvmes[@]}" -eq 1 ]; then
    TARGET="${nvmes[0]}"
  else
    echo
    echo "Pick the OS drive by index:"
    for i in "${!nvmes[@]}"; do
      echo "  $i: ${nvmes[$i]}  $(lsblk -d -n -o SIZE "${nvmes[$i]}")"
    done
    read -rp "Index: " idx </dev/tty
    TARGET="${nvmes[$idx]}"
  fi

  # The data-drive guard from depot is meaningless on a single-disk
  # laptop, but refusing anything non-NVMe still costs nothing and stops
  # a mistyped index from targeting a plugged-in USB stick.
  case "$TARGET" in
    /dev/sd*)
      echo "Refusing to install on non-NVMe target $TARGET." >&2
      exit 1
      ;;
  esac

  echo
  echo "=========================================================="
  echo "  WILL WIPE AND INSTALL ARCH ON: $TARGET"
  echo "  Every byte on this device will be destroyed."
  echo "=========================================================="
  read -rp "Type 'yes' to continue: " confirm </dev/tty
  [ "$confirm" = "yes" ] || { echo "Aborted."; exit 1; }
  export TARGET
}

enable_clock_sync() {
  timedatectl set-ntp true
}

partition_drive() {
  echo "Partitioning $TARGET..."
  parted -s "$TARGET" mklabel gpt
  parted -s "$TARGET" mkpart EFI fat32 1MiB 1025MiB
  parted -s "$TARGET" set 1 esp on
  parted -s "$TARGET" mkpart root ext4 1025MiB 100%

  # NVMe partitions get a 'p<N>' suffix (/dev/nvme0n1p1), unlike SATA.
  PART_EFI="${TARGET}p1"
  PART_ROOT="${TARGET}p2"
  export PART_EFI PART_ROOT

  partprobe "$TARGET"
  sleep 2
}

format_partitions() {
  mkfs.fat -F 32 -n EFI "$PART_EFI"
  mkfs.ext4 -F -L root "$PART_ROOT"
}

mount_partitions() {
  mount "$PART_ROOT" /mnt
  mkdir -p /mnt/boot
  mount -o fmask=0077,dmask=0077 "$PART_EFI" /mnt/boot
}

install_base_system() {
  echo "Installing base packages (pacstrap)..."
  local packages=(base linux linux-firmware git networkmanager sudo vim)
  [ -n "$INSTALL_MICROCODE" ] && packages+=("$INSTALL_MICROCODE")
  pacstrap -K /mnt "${packages[@]}"
}

write_fstab() {
  genfstab -U /mnt >> /mnt/etc/fstab
}

bind_repo_into_chroot() {
  mkdir -p /mnt/orchard-installer
  mount --bind "$ORCHARD_ROOT" /mnt/orchard-installer
}

configure_new_system_in_chroot() {
  echo "Configuring new system..."
  arch-chroot /mnt env \
    INSTALL_HOSTNAME="$INSTALL_HOSTNAME" \
    INSTALL_USERNAME="$INSTALL_USERNAME" \
    INSTALL_USER_PASSWORD="$INSTALL_USER_PASSWORD" \
    INSTALL_MICROCODE="$INSTALL_MICROCODE" \
    PART_ROOT="$PART_ROOT" \
    bash /orchard-installer/install-arch/dell-xps-14 --chroot-phase </dev/tty
}

remove_usb_then_reboot() {
  umount /mnt/orchard-installer
  rmdir /mnt/orchard-installer
  umount -R /mnt

  echo
  echo "=========================================================="
  echo "  Base install complete."
  echo
  echo "  REMOVE THE USB DRIVE, then press Enter to reboot."
  echo "  After reboot: sign in, connect wifi with nmtui, then follow"
  echo "  the 'Dell XPS 14' section of orchard's README to configure."
  echo "=========================================================="
  read -r -p "> " _ </dev/tty || true
  reboot
}

set_timezone() {
  local current
  current=$(timedatectl show --value -p Timezone 2>/dev/null || echo UTC)
  case "$current" in
    UTC|Etc/UTC) ;;
    *) return 0 ;;
  esac

  local timezone
  timezone=$(tzselect | tail -1) || { echo "tzselect aborted; leaving UTC." >&2; return 0; }
  [ -n "$timezone" ] || { echo "No selection; leaving UTC." >&2; return 0; }

  ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
  hwclock --systohc
}

set_locale() {
  sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen
  locale-gen
  echo "LANG=en_US.UTF-8" > /etc/locale.conf
}

set_hostname() {
  echo "$INSTALL_HOSTNAME" > /etc/hostname
  cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $INSTALL_HOSTNAME.localdomain $INSTALL_HOSTNAME
EOF
}

create_user() {
  id "$INSTALL_USERNAME" >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash "$INSTALL_USERNAME"
  if [ "$(passwd -S "$INSTALL_USERNAME" 2>/dev/null | awk '{print $2}')" != "P" ]; then
    echo "$INSTALL_USERNAME:$INSTALL_USER_PASSWORD" | chpasswd
  fi
}

mirror_user_password_to_root() {
  # A forgotten user password or broken sudo/shell is recoverable from
  # the root TTY with the same password. Copy the hash, never re-derive
  # the plaintext.
  local hash
  hash=$(getent shadow "$INSTALL_USERNAME" | cut -d: -f2)
  case "$hash" in
    ""|"!"*|"*") echo "user $INSTALL_USERNAME has no password set" >&2; exit 1 ;;
  esac
  echo "root:$hash" | chpasswd -e
}

grant_wheel_sudo() {
  echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
  chmod 440 /etc/sudoers.d/10-wheel
  visudo -cf /etc/sudoers.d/10-wheel
}

install_bootloader() {
  bootctl --esp-path=/boot install

  # PARTUUID survives cable swaps and re-enumeration; /dev names don't.
  local root_partuuid
  root_partuuid=$(blkid -s PARTUUID -o value "$PART_ROOT")

  cat > /boot/loader/loader.conf <<EOF
default arch.conf
timeout 0
console-mode max
editor no
EOF

  # The microcode initrd must be listed BEFORE the main initramfs so the
  # CPU loads the update before userspace comes up.
  {
    echo "title   Arch Linux"
    echo "linux   /vmlinuz-linux"
    [ -n "$INSTALL_MICROCODE" ] && echo "initrd  /$INSTALL_MICROCODE.img"
    echo "initrd  /initramfs-linux.img"
    echo "options root=PARTUUID=$root_partuuid rw"
  } > /boot/loader/entries/arch.conf
}

enable_networkmanager() {
  systemctl enable NetworkManager.service
}

copy_repo_into_user_home() {
  local destination="/home/$INSTALL_USERNAME/code/orchard"
  mkdir -p "$(dirname "$destination")"
  [ -d "$destination" ] || cp -r /orchard-installer "$destination"
  chown -R "$INSTALL_USERNAME:$INSTALL_USERNAME" "/home/$INSTALL_USERNAME/code"
}

run_inside_chroot() {
  set_timezone
  set_locale
  set_hostname
  create_user
  mirror_user_password_to_root
  grant_wheel_sudo
  install_bootloader
  enable_networkmanager
  copy_repo_into_user_home
}

# --chroot-phase re-invokes this same file inside arch-chroot so the
# functions above run against the newly-installed system, not the ISO.
if [ "${1:-}" = "--chroot-phase" ]; then
  run_inside_chroot
  exit 0
fi

ORCHARD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

require_root
require_uefi
collect_install_details
pick_os_drive
enable_clock_sync
partition_drive
format_partitions
mount_partitions
install_base_system
write_fstab
bind_repo_into_chroot
configure_new_system_in_chroot
remove_usb_then_reboot
