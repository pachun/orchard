#!/usr/bin/env bash
# User-mode setup. Walks configuration/cli (always) and
# configuration/desktop (if MODE=desktop or unset). Each subdirectory is one feature
# with its own install.sh — adding/removing a feature is just create or
# delete the folder. Idempotent — re-run any time.
set -euo pipefail
shopt -s nullglob

MODE="${1:-desktop}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Available to every feature script — zsh's installer writes it into
# the generated ~/.zshrc, others can branch on it if they need to.
export ORCHARD_MODE="$MODE"
export TOOLS="$HERE/tools"

# Phase 1: source every feature's prompts.sh (if it has one) so all
# interactive prompts happen up front. Each prompts.sh is idempotent;
# it skips itself when its inputs are already collected or already
# applied. install.sh files source their sibling prompts.sh too, so
# standalone runs of individual features still work.
for d in "$HERE/configuration/cli"/*/; do
  [ -f "$d/prompts.sh" ] && source "$d/prompts.sh"
done

if [[ "$MODE" == "desktop" ]]; then
  for d in "$HERE/configuration/desktop"/*/; do
    [ -f "$d/prompts.sh" ] && source "$d/prompts.sh"
  done
fi

# One password prompt for the whole run, and a mistyped one just asks
# again. Left to the features' own sudo calls, the first prompt lands
# somewhere in the middle of the output, and a wrong answer there — or at
# the re-prompt sudo issues once its timestamp lapses during a long AUR
# build — aborts the entire run under set -e.
authenticate_sudo() {
  until sudo -v; do
    echo "Wrong password. Try again."
  done
}

keep_sudo_alive_until_done() {
  while true; do
    sudo -n true || true
    sleep 60
  done 2>/dev/null &
  local keepalive_pid=$!
  trap 'kill "$keepalive_pid" 2>/dev/null' EXIT
}

authenticate_sudo
keep_sudo_alive_until_done

# Phase 2: run the actual installs unattended.
for d in "$HERE/configuration/cli"/*/; do
  bash "$d/install.sh"
done

if [[ "$MODE" == "desktop" ]]; then
  for d in "$HERE/configuration/desktop"/*/; do
    bash "$d/install.sh"
  done
fi

# Prune orphaned links. link.sh only ever creates symlinks, so a component
# that was deleted or renamed leaves its old link behind, dangling — and a
# re-run can't notice, because nothing owns that link anymore. Delete any
# broken symlink still pointing into the repo; a live component's link isn't
# broken, so this only ever clears true orphans, never a valid link.
find "$HOME/.config" "$HOME/.local" "$HOME/.claude" -xtype l -lname "$HERE/*" -delete 2>/dev/null || true
find "$HOME" -maxdepth 1 -xtype l -lname "$HERE/*" -delete 2>/dev/null || true

# The first desktop bringup ends in a reboot so you land at the login ->
# Hyprland. The pgrep guard skips it when configure is re-run from inside a
# running session to apply changes — that must never reboot the user out.
if [[ "$MODE" == "desktop" ]] && ! pgrep -x Hyprland >/dev/null 2>&1; then
  sudo reboot
fi
