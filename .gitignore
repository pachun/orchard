# Python bytecode cache. The hooks under configuration/cli/claude/config/hooks/
# are imported/executed by Claude Code and Python writes __pycache__ next
# to them on first run.
__pycache__/
*.pyc

# Work-private Claude skills. This repo is public; skills like /qar
# review a client's codebase and must never be committed here — the
# work security team would treat that as a leak. tools/link.sh only
# ever symlinks repo -> $HOME (never the reverse), so a skill could
# only land in the repo by a manual mistake; this is the backstop.
# Public skills, if any are ever wanted, can be force-added.
configuration/cli/claude/config/skills/
