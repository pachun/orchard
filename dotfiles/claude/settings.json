{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "WebFetch",
      "Bash(gh search *)",
      "Bash(systemctl is-active *)",
      "Bash(pacman -Q keyd)",
      "Bash(cargo build *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(awk *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git config --list)",
      "Bash(git config --get *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git stash list)",
      "Bash(git reflog *)",
      "Bash(git describe *)"
    ],
    "deny": [
      "WebFetch(domain:gitlab.com)",
      "Bash(glab *)",
      "WebFetch(domain:teams.microsoft.com)",
      "WebFetch(domain:teams.live.com)",
      "WebFetch(domain:*.teams.microsoft.com)",
      "WebFetch(domain:*.atlassian.net)",
      "WebFetch(domain:*.jira.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 $HOME/.claude/hooks/auto-allow-read-pipelines.py'"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "editorMode": "vim",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
