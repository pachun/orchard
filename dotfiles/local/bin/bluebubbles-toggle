#!/bin/sh
# Cmd+I toggle for BlueBubbles, three-state:
#   1. not running                  → launch it
#   2. running, currently focused   → move to a hidden "special" workspace
#                                     (Hyprland's scratchpad equivalent of
#                                     macOS minimize)
#   3. running, on special ws       → move back to the focused workspace
#                                     and refocus (the "unminimize" path)
#   4. running, on a regular ws     → focus its workspace + raise
set -eu

CLASS="bluebubbles"
SPECIAL="special:bluebubbles"

clients="$(hyprctl clients -j)"
client="$(printf '%s' "$clients" | jq -c ".[] | select(.class == \"$CLASS\")" | head -1)"

if [ -z "$client" ]; then
    exec bluebubbles
fi

addr="$(printf '%s' "$client" | jq -r '.address')"
ws_name="$(printf '%s' "$client" | jq -r '.workspace.name')"
active_addr="$(hyprctl activewindow -j | jq -r '.address // ""')"

case "$ws_name" in
    "special:bluebubbles")
        # Unminimize. If the current workspace is empty, land there;
        # otherwise pick the lowest empty workspace so BlueBubbles
        # never stacks on top of whatever the user was already doing.
        current_ws="$(hyprctl activeworkspace -j | jq -r '.id')"
        current_count="$(hyprctl activeworkspace -j | jq -r '.windows')"
        if [ "$current_count" = "0" ]; then
            target="$current_ws"
        else
            used="$(hyprctl workspaces -j | jq '[.[].id | select(. > 0)]')"
            target=1
            while printf '%s' "$used" | jq -e --argjson n "$target" 'index($n)' >/dev/null; do
                target=$((target + 1))
            done
        fi
        hyprctl dispatch movetoworkspace "$target,address:$addr"
        ;;
    *)
        if [ "$active_addr" = "$addr" ]; then
            # Minimize: stash it in the named special workspace.
            # `movetoworkspacesilent` doesn't switch the user's view.
            hyprctl dispatch movetoworkspacesilent "$SPECIAL,address:$addr"
        else
            # Visible somewhere else — jump to it.
            hyprctl dispatch focuswindow "address:$addr"
        fi
        ;;
esac
