#!/usr/bin/env bash
# Screen brightness with macOS-style power-off at the bottom of the range.
# Apple panels have a hardware-floor brightness > 0, so dimming all the way
# leaves a visible glow. macOS turns the backlight power off entirely at
# minimum; we replicate that via Hyprland's DPMS dispatch.
#
# Usage: screen-brightness up|down [STEP%]   (STEP defaults to 5%)
# 5% pairs well with Hyprland's `binde` at the default 25 Hz repeat rate:
# a single tap moves a noticeable amount, holding ramps full-range in ~0.8s.
set -euo pipefail

DEVICE=apple-panel-bl
STEP="${2:-5%}"

show_osd() {
  local val max fraction
  val=$(brightnessctl --device "$DEVICE" get)
  max=$(brightnessctl --device "$DEVICE" max)
  # swayosd's --custom-progress wants 0.0-1.0, not a percent.
  fraction=$(awk -v v="$val" -v m="$max" 'BEGIN { printf "%.3f", v/m }')
  swayosd-client --custom-progress "$fraction" --custom-icon display-brightness-symbolic 2>/dev/null || true
}

cur="$(brightnessctl --device "$DEVICE" get)"

case "${1:-}" in
  down)
    if [ "$cur" = "0" ]; then
      hyprctl dispatch dpms off >/dev/null
    else
      brightnessctl --device "$DEVICE" --min-value=0 set "${STEP}-" >/dev/null
      if [ "$(brightnessctl --device "$DEVICE" get)" = "0" ]; then
        hyprctl dispatch dpms off >/dev/null
      fi
    fi
    show_osd
    ;;
  up)
    if [ "$cur" = "0" ]; then
      hyprctl dispatch dpms on >/dev/null
      brightnessctl --device "$DEVICE" set "$STEP" >/dev/null
    else
      brightnessctl --device "$DEVICE" --min-value=0 set "${STEP}+" >/dev/null
    fi
    show_osd
    ;;
  *)
    echo "usage: $(basename "$0") up|down [STEP%]" >&2
    exit 2
    ;;
esac
