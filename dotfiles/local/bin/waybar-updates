#!/bin/sh
# waybar-updates: count pending pacman + AUR updates and emit a JSON
# blob for waybar's custom module. Returns empty (waybar hides the
# module) when there's nothing to do OR when we're offline — yay -Syu
# can't run without network, so a count badge with no actionable path
# is just noise.
#
# Architecture: stale-while-revalidate.
#   - Waybar polls every minute; the script reads /tmp/waybar-updates.cache
#     and prints it in <10ms.
#   - If the cache is older than $MAX_AGE, a background refresh kicks
#     off (checkupdates + yay -Qua, ~1s total) and signals SIGRTMIN+10
#     to waybar when done.
#   - A flag file at /tmp/waybar-updates.refreshing dedupes concurrent
#     refresh runs. If the flag's older than $LOCK_TTL the prior runner
#     was killed (e.g. a waybar restart took out the subshell with
#     SIGKILL before its trap could fire) — we ignore the stale lock
#     and start a new refresh.
#
# system-update wipes the cache + signals waybar after a successful
# upgrade so the badge clears immediately rather than waiting on the
# next refresh window.
#
# Phosphor download-simple (U+E20C) is the entire visible text — the
# count goes in the tooltip, not the bar, so it doesn't visually collide
# with neighboring numeric modules.

CACHE=/tmp/waybar-updates.cache
LOCK=/tmp/waybar-updates.refreshing
MAX_AGE=900   # 15 min cache TTL
LOCK_TTL=60   # any lock older than this is presumed orphaned

# Bail when offline. nmcli's STATE is 'connected' when any active
# connection is up (wifi or wired); 'disconnected' / 'connecting' /
# 'asleep' all mean "no actionable network yet". Reads NM's cached
# state, no network probing — fast.
nm_state=$(nmcli -t -f STATE general 2>/dev/null)
[ "$nm_state" = "connected" ] || exit 0

lock_alive=0
if [ -f "$LOCK" ]; then
    lock_age=$(($(date +%s) - $(stat -c %Y "$LOCK" 2>/dev/null || echo 0)))
    [ "$lock_age" -lt "$LOCK_TTL" ] && lock_alive=1
fi

now=$(date +%s)
mtime=0
[ -f "$CACHE" ] && mtime=$(stat -c %Y "$CACHE" 2>/dev/null || echo 0)
cache_stale=1
[ -f "$CACHE" ] && [ $((now - mtime)) -lt "$MAX_AGE" ] && cache_stale=0

if [ "$cache_stale" -eq 1 ] && [ "$lock_alive" -eq 0 ]; then
    (
        touch "$LOCK"
        trap 'rm -f "$LOCK"' EXIT
        repo=$(checkupdates 2>/dev/null | wc -l)
        aur=$(timeout 30 yay -Qua 2>/dev/null | wc -l)
        total=$((repo + aur))
        if [ "$total" -eq 0 ]; then
            : > "$CACHE"
        else
            tooltip="$total pending — $repo from repos"
            [ "$aur" -gt 0 ] && tooltip="$tooltip, $aur from AUR"
            printf '{"text":"","tooltip":"%s"}\n' \
                "$tooltip" > "$CACHE"
        fi
        pkill -RTMIN+10 waybar 2>/dev/null || true
    ) >/dev/null 2>&1 &
fi

# Output current cache (may be slightly stale; empty file → hidden).
[ -s "$CACHE" ] && cat "$CACHE"
exit 0
