#!/usr/bin/env bash
# Cycle through workspaces 1..MAX with wrap-around at both ends. Bound
# to Ctrl+Left/Right in hyprland.conf.
#
# Usage: workspace-cycle left|right
set -euo pipefail

MAX=5

dir="${1:-}"
[ "$dir" = "left" ] || [ "$dir" = "right" ] || { echo "usage: $(basename "$0") left|right" >&2; exit 2; }

current=$(hyprctl activeworkspace -j | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')

case "$dir" in
  right)
    target=$((current + 1))
    [ "$target" -gt "$MAX" ] && target=1
    ;;
  left)
    target=$((current - 1))
    [ "$target" -lt 1 ] && target="$MAX"
    ;;
esac

hyprctl dispatch workspace "$target" >/dev/null
