#!/usr/bin/env python3
"""macOS-style waybar auto-hide for Hyprland fullscreen video.

Hides the bar only when the *currently focused* window is in true
fullscreen (Hyprland fullscreen state 2 — F11 in chromium, etc.). On
workspaces with normal tiled windows the bar stays visible, even
though those windows fill the screen (gaps_in/out are 0). This is
the macOS pattern: bar always there, except when you're watching a
fullscreen video and want every pixel.

While fullscreen is active, cursor at the top edge (≤5px) reveals
the bar; cursor below ~35px hides it again. Cursor polling only
runs during fullscreen, so steady-state overhead is just sitting
blocked on the Hyprland event socket.

Talks to waybar via SIGUSR1 — its "toggle visibility" signal. There
is no separate show/hide signal, and as of waybar 0.15 a hidden
bar's layer surface stays in `hyprctl layers -j` with unchanged
geometry — so its real visibility cannot be read back. We therefore
track the bar's state ourselves and only signal when that state
disagrees with what we want. The one drift case we still recover
from is a waybar restart: a changed PID set means a fresh, and
therefore visible, bar.
"""
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time

REVEAL_Y = 5
HIDE_Y = 35
POLL_INTERVAL = 0.05  # 50ms — responsive enough to feel instant

# Hyprland reports the focused window's fullscreen mode here:
#   0 = tiled / floating (not fullscreen)
#   1 = maximized
#   2 = fullscreen (true fullscreen, what F11 / dispatcher fires)
#   3 = both (rare combined state)
# We match >= 2 so true-fullscreen and the "both" combo trigger,
# but normal tiled / maximized doesn't.
FULLSCREEN_THRESHOLD = 2

# Re-check the active window's fullscreen state on any of these
# events. `fullscreen>>` covers explicit toggles; the workspace /
# active-window / monitor events catch the case where a fullscreen
# window stays fullscreen on its workspace but the user switches
# focus elsewhere — Hyprland doesn't fire a fullscreen event then,
# so without these we'd stay locked in hide-mode after focus moves.
RECHECK_PREFIXES = (
    "fullscreen>>",
    "workspace>>",
    "activewindow>>",
    "focusedmon>>",
)

instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
if not instance:
    sys.exit("HYPRLAND_INSTANCE_SIGNATURE not set; not inside a Hyprland session?")
sock_path = f"{xdg_runtime}/hypr/{instance}/.socket2.sock"


# Lock keeps set_bar()'s tracked-state read, toggle signal, and
# tracked-state write atomic across the event-loop and cursor-poll
# threads.
_lock = threading.Lock()
fullscreen_active = False
# The cursor-poll thread for the current fullscreen session, kept so
# update_fullscreen_state() can join it before restoring the bar.
poll_thread = None

# waybar's SIGUSR1 is a pure toggle and a hidden bar is indis-
# tinguishable from a visible one via hyprctl, so we track visibility
# ourselves. waybar always starts up visible.
_bar_visible = True
# Last-seen set of waybar PIDs; a change means waybar was restarted.
_waybar_pids_seen = None


def waybar_pids():
    out = subprocess.run(["pgrep", "-x", "waybar"], capture_output=True, text=True)
    return [int(p) for p in out.stdout.split()]


def set_bar(visible):
    """Make waybar's visibility match `visible`. SIGUSR1 only toggles,
    so we fire it just when our tracked `_bar_visible` disagrees with
    the target. A changed PID set means waybar restarted — a fresh bar
    is always visible — so we resync before deciding, recovering from
    the one drift case explicit tracking can't otherwise survive."""
    global _bar_visible, _waybar_pids_seen
    with _lock:
        pids = waybar_pids()
        pid_set = frozenset(pids)
        if _waybar_pids_seen is not None and pid_set != _waybar_pids_seen:
            _bar_visible = True
        _waybar_pids_seen = pid_set

        if not pids or _bar_visible == visible:
            return
        for pid in pids:
            try:
                os.kill(pid, signal.SIGUSR1)
            except OSError:
                pass
        _bar_visible = visible


def active_window_is_fullscreen():
    out = subprocess.run(
        ["hyprctl", "activewindow", "-j"], capture_output=True, text=True
    )
    if not out.stdout.strip():
        return False
    try:
        data = json.loads(out.stdout)
    except json.JSONDecodeError:
        return False
    return data.get("fullscreen", 0) >= FULLSCREEN_THRESHOLD


def cursor_y():
    out = subprocess.run(["hyprctl", "cursorpos"], capture_output=True, text=True)
    parts = out.stdout.strip().split(",")
    if len(parts) >= 2:
        try:
            return int(parts[1].strip())
        except ValueError:
            return None
    return None


def poll_cursor_loop():
    # Act only when the cursor *crosses* a zone boundary. REVEAL_Y and
    # HIDE_Y leave a dead zone between them for hysteresis; tracking
    # `last_desired` makes us fire set_bar() once per transition rather
    # than every tick. The `fullscreen_active` re-check drops a hide
    # that would land after fullscreen already ended — the bar is
    # about to be restored, so hiding it first would only flash it.
    last_desired = False  # we just hid on entering fullscreen
    while fullscreen_active:
        y = cursor_y()
        if y is not None:
            desired = None
            if y < REVEAL_Y:
                desired = True
            elif y > HIDE_Y:
                desired = False
            if desired is not None and desired != last_desired and fullscreen_active:
                set_bar(desired)
                last_desired = desired
        time.sleep(POLL_INTERVAL)


def update_fullscreen_state():
    global fullscreen_active, poll_thread
    new_state = active_window_is_fullscreen()
    if new_state == fullscreen_active:
        return
    fullscreen_active = new_state
    if new_state:
        set_bar(False)
        poll_thread = threading.Thread(target=poll_cursor_loop, daemon=True)
        poll_thread.start()
    else:
        # Join the cursor-poll thread before restoring the bar: its
        # final iteration must not fire a hide *after* our show, or
        # the bar stays stuck off-screen. That was the un-fullscreen
        # bug — set_bar(True) ran, then a late poll tick hid it again.
        if poll_thread is not None:
            poll_thread.join()
            poll_thread = None
        set_bar(True)


s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)

# Sync state at startup so a fullscreen window that already exists when
# the daemon starts (e.g., after a hyprctl reload that re-fires
# exec-once) is reflected immediately, not on the next event.
update_fullscreen_state()

buf = b""
while True:
    chunk = s.recv(4096)
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        event = line.decode(errors="replace")
        if any(event.startswith(p) for p in RECHECK_PREFIXES):
            update_fullscreen_state()
