#!/usr/bin/env bash
# Rebuild gitspine from ~/code/gitspine in release mode. The
# ~/.local/bin/gitspine symlink set up by install-gitspine.sh points at
# target/release/gitspine, so cargo's in-place rewrite of that file is
# all it takes for the next `gitspine` invocation to run the new binary.
#
# Personal dev tool — not invoked by setup/install.sh.
set -euo pipefail

cd "$HOME/code/gitspine"
cargo build --release
