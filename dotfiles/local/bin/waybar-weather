#!/bin/bash
# Waybar weather module: fetches current condition + temperature from
# wttr.in (location auto-detected from IP, units forced to US/Fahrenheit)
# and emits "<icon> <temp>". Requires bash for the $'\UXXXXXXXX' escape
# sequences used to embed the supplementary-plane MDI weather glyphs
# from Symbols Nerd Font Mono (same icon family as battery / wifi —
# outlined silhouette with state shown by partial fills inside).
#
# Resilience: every successful fetch caches its output. On network
# failure we emit the cached value instead of "--", so the bar stays
# populated through brief outages and post-sleep wifi reconnects.
# A NetworkManager dispatcher (configure-network-dispatcher.sh) sends
# SIGRTMIN+9 to waybar on interface up so the next refresh happens
# within seconds of reconnect rather than up to 10 minutes later.
set -eu

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-weather"
mkdir -p "$(dirname "$CACHE")"

emit_cached() {
    if [ -s "$CACHE" ]; then
        cat "$CACHE"
    else
        printf '%s\n' '--'
    fi
}

raw=$(curl -s --max-time 5 'https://wttr.in/?u&format=%C|%t' 2>/dev/null || true)

if [ -z "$raw" ] || echo "$raw" | grep -qiE 'unknown|error|<html'; then
    emit_cached
    exit 0
fi

condition=${raw%|*}
temp=${raw#*|}
temp=${temp#+}    # strip the leading "+" from "+71°F"

# Use night glyph for clear-sky conditions outside daylight hours.
hour=$(date +%H)
is_night=0
if [ "$hour" -lt 6 ] || [ "$hour" -ge 20 ]; then
    is_night=1
fi

# Phosphor weather glyphs (matches the rest of the right-side icon
# row's font for consistent stroke / baseline). Codepoints in the
# Unicode PUA range; bash $'\uXXXX' literals embed them inline.
icon=$'\ue472'  # sun
case "$condition" in
    Sunny|Clear)
        if [ "$is_night" -eq 1 ]; then icon=$'\ue58e'; else icon=$'\ue472'; fi
        ;;
    'Partly cloudy'|'Partly Cloudy')
        if [ "$is_night" -eq 1 ]; then icon=$'\ue53e'; else icon=$'\ue540'; fi
        ;;
    Cloudy|Overcast)              icon=$'\ue1aa' ;;
    Mist|Fog|Haze)                icon=$'\ue53c' ;;
    *Rain*|Drizzle*|*Shower*)     icon=$'\ue1b4' ;;
    *Snow*|Blizzard*|Sleet*)      icon=$'\ue1b8' ;;
    *Thunder*|*Storm*)            icon=$'\ue1b2' ;;
esac

# Wrap the icon in Pango markup so we can shift it independently of
# the temp text. Phosphor's weather glyphs (moon, sun, cloud-sun)
# occupy the upper half of their em-square, sitting visibly above the
# rest of the row. rise is in 1/10000 of em — negative pushes down.
# -2500 ≈ 0.25em down, which centers the glyph against neighboring
# icons. The custom module needs markup=pango (set in config.jsonc).
output=$(printf '<span rise="-1200" letter_spacing="4000">%s</span> %s\n' "$icon" "$temp")
printf '%s\n' "$output" | tee "$CACHE"
