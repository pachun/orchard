#!/bin/bash
# Waybar weather module: fetches current condition + temperature from
# wttr.in (location auto-detected from IP, units forced to US/Fahrenheit)
# and emits "<icon> <temp>". Requires bash for the $'\UXXXXXXXX' escape
# sequences used to embed the supplementary-plane MDI weather glyphs
# from Symbols Nerd Font Mono (same icon family as battery / wifi —
# outlined silhouette with state shown by partial fills inside).
#
# Resilience: every successful fetch caches its output. On network
# failure we emit the cached value instead of "--", so the bar stays
# populated through brief outages and post-sleep wifi reconnects.
# A NetworkManager dispatcher (configure-network-dispatcher.sh) sends
# SIGRTMIN+8 to waybar on interface up so the next refresh happens
# within seconds of reconnect rather than up to 10 minutes later.
set -eu

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar-weather"
mkdir -p "$(dirname "$CACHE")"

emit_cached() {
    if [ -s "$CACHE" ]; then
        cat "$CACHE"
    else
        printf '%s\n' '--'
    fi
}

raw=$(curl -s --max-time 5 'https://wttr.in/?u&format=%C|%t' 2>/dev/null || true)

if [ -z "$raw" ] || echo "$raw" | grep -qiE 'unknown|error|<html'; then
    emit_cached
    exit 0
fi

condition=${raw%|*}
temp=${raw#*|}
temp=${temp#+}    # strip the leading "+" from "+71°F"

# Use night glyph for clear-sky conditions outside daylight hours.
hour=$(date +%H)
is_night=0
if [ "$hour" -lt 6 ] || [ "$hour" -ge 20 ]; then
    is_night=1
fi

# Outlined MDI weather glyphs from Symbols Nerd Font (U+F05xx range,
# nf-md-weather_*). Same icon family as battery (nf-md-battery_*) and
# wifi (nf-md-wifi_*) — outlined silhouette, state shown by fills inside.
icon=$'\U000F0599'  # mdi-weather-sunny
case "$condition" in
    Sunny|Clear)
        if [ "$is_night" -eq 1 ]; then icon=$'\U000F0594'; else icon=$'\U000F0599'; fi
        ;;
    'Partly cloudy'|'Partly Cloudy')
        if [ "$is_night" -eq 1 ]; then icon=$'\U000F0F31'; else icon=$'\U000F0595'; fi
        ;;
    Cloudy|Overcast)              icon=$'\U000F0590' ;;
    Mist|Fog|Haze)                icon=$'\U000F0591' ;;
    *Rain*|Drizzle*|*Shower*)     icon=$'\U000F0596' ;;
    *Snow*|Blizzard*|Sleet*)      icon=$'\U000F0598' ;;
    *Thunder*|*Storm*)            icon=$'\U000F0593' ;;
esac

output=$(printf '%s %s\n' "$icon" "$temp")
printf '%s\n' "$output" | tee "$CACHE"
