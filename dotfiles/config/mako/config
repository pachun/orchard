# Mako notification daemon. Symlinked from this repo by dotfiles/link.sh.
# Reload after edits with `makoctl reload`. SF Pro Text (waybar's
# typeface) so notifications feel like the bar's overflow, not a
# different surface.
#
# Colors, the format string (whose body-text color is embedded), and
# per-urgency border colors all live in the active orchard-theme
# partial pulled in via the include directive below. Main config
# owns layout (font, anchor, padding, timeouts). set-theme calls
# `makoctl reload` after swapping the active symlink so live mako
# picks up the new palette.

include=~/.config/orchard-themes/active/mako

font=SF Pro Text 11

border-size=1
border-radius=10

# Top-right, with a small inset so toasts don't kiss the screen edge.
anchor=top-right
margin=12
padding=14,16

width=340
height=120
max-icon-size=48

default-timeout=5000
ignore-timeout=1

[urgency=critical]
default-timeout=0

# Do-not-disturb mode (toggled by ~/.local/bin/dnd-toggle via
# `makoctl mode -t do-not-disturb`). `invisible=1` makes mako drop
# every notification while the mode is active — without this the
# mode is purely decorative and toasts still show.
[mode=do-not-disturb]
invisible=1
