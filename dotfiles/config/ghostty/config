# Ghostty config. Symlinked from this repo by dotfiles/link.sh.

# macOS-style copy/paste with Cmd (Super on Linux). xremap is configured
# to NOT touch ghostty, so Super+C/V reach the terminal untranslated and
# trigger the binds below — giving us "Cmd+C copies, Ctrl+C interrupts"
# behavior to match macOS.
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# Cmd+W closes the current pane/tab; if it's the last one, closes the window.
# (Cmd+Q is handled at the Hyprland level via killactive.)
keybind = super+w=close_surface
keybind = super+t=new_tab

# Free up Ctrl+- for nvim's comment-toggle binding. Ghostty's default
# `ctrl+- = decrease_font_size` would otherwise eat the keypress (which
# nvim wants to see as <C-_> for Comment.nvim). ctrl+= / ctrl++ still
# zoom in, so we lose nothing meaningful — they're cleaner targets for
# zoom anyway.
keybind = ctrl+-=unbind

# Don't pop a "Potentially Unsafe Paste" warning for content with newlines
# or escape sequences. Paste normally and trust the source.
clipboard-paste-protection = false

# MonoLisa Variable ships named instances (Light, Regular, Medium,
# SemiBold, Bold, ExtraBold, ...). On Linux, ghostty has no font-thicken
# equivalent — pick a heavier named instance via font-style instead.
# Theme is sourced from ~/.config/orchard-themes/active/ghostty.conf,
# which is a symlink the `set-theme` script repoints when switching.
# Open windows reload via SIGUSR2 (sent by set-theme).
config-file = ~/.config/orchard-themes/active/ghostty.conf

font-family = "MonoLisa Variable"
# Fallback font for nerd-font codepoints (diagnostic icons in nvim,
# git/folder glyphs in lazygit/gh, devicons via lualine, etc.). MonoLisa
# doesn't ship those glyphs; without a fallback they render as tofu.
# Repeated `font-family` directives form ghostty's fallback chain.
font-family = "Symbols Nerd Font Mono"
font-style = Medium

# Disable programming ligatures (== stays "==", => stays "=>", etc.).
font-feature = -calt, -liga, -dlig

# Default to a block cursor everywhere — including at the shell prompt
# (ghostty's shell integration normally sets a bar there, this disables that).
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Auto-start each ghostty surface inside a fresh tmux session. The wrapper
# is symlinked into ~/.local/bin/ by dotfiles/link.sh.
command = $HOME/.local/bin/ghostty-tmux-launcher
