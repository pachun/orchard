{
    "layer": "top",
    "position": "top",
    // Sized to match the M2 MacBook Air notch strip: 1664 - 1600 = 64
    // physical px = 32 logical px at scale 2.0. The bar fills that strip
    // exactly, with the camera cutout hiding the center. Modules need
    // to live on the far left / right when added.
    "height": 29,
    "spacing": 0,
    "modules-left": ["custom/system", "hyprland/workspaces"],

    "custom/system": {
        // Arch logo (nf-md-arch, U+F08C7) — same MDI family as the icons
        // on the right. Click opens a fuzzel menu with Update / Reboot /
        // Shut down actions. See ~/.local/bin/system-menu.
        "format": "󰣇",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/system-menu"
    },
    "modules-center": [],
    "modules-right": ["custom/dnd", "custom/recording", "custom/weather", "battery", "custom/nordvpn", "custom/wifi-status", "network", "custom/clock"],

    "custom/dnd": {
        // Bell icon (bell-off when DND is on). Sits as the leftmost
        // right-side module so it's adjacent to the notch — the most
        // visible spot on the bar. Polled every 30s as a safety net,
        // but dnd-toggle sends SIGRTMIN+7 to flip the icon immediately.
        // Click toggles the mode; F6 in hyprland.conf does the same.
        "exec": "$HOME/.local/bin/waybar-dnd",
        "return-type": "json",
        "interval": 30,
        "signal": 7,
        "on-click": "$HOME/.local/bin/dnd-toggle"
    },

    "custom/recording": {
        // Visible only while wf-recorder is running. Click stops the
        // recording (the screenrecord script detects an existing
        // wf-recorder and pkills it as its toggle-off behavior).
        "exec": "$HOME/.local/bin/waybar-recording-status",
        "return-type": "json",
        "interval": 1,
        "on-click": "$HOME/.local/bin/screenrecord"
    },

    "hyprland/workspaces": {
        // Always show 1..5 even when empty. Click to switch. Each
        // workspace shows its number; the active one is replaced by
        // a rounded square via CSS (color: transparent + filled bg).
        "format": "{id}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "on-click": "activate"
    },

    "custom/weather": {
        // Wraps wttr.in via dotfiles/local/bin/waybar-weather. Polls
        // every 10 minutes — weather doesn't move fast and this keeps
        // network chatter low. SIGRTMIN+8 forces an immediate refresh;
        // a NetworkManager dispatcher fires it on interface-up so we
        // don't wait 10 min for the next poll after wifi reconnects.
        "exec": "$HOME/.local/bin/waybar-weather",
        "interval": 600,
        "signal": 8,
        "on-click": "$HOME/.local/bin/focus-or-launch org.gnome.Weather gnome-weather"
    },

    "battery": {
        // 11 fill-level glyphs mapped to 10-percent buckets. When
        // charging, swap the fill-level icon for a lightning bolt —
        // distinct silhouette so the state reads at a glance even at
        // small sizes. 2-second poll picks up plug/unplug nearly
        // instantly; reading a sysfs file is free.
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󱐋",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 2
    },

    "custom/nordvpn": {
        // Shield icon. Filled+check when connected, off-outline when
        // not. Click → fuzzel picker (Disconnect / Dedicated IP /
        // Quickest / countries → cities). Polled every 10s; nordvpn-menu
        // sends SIGRTMIN+9 after explicit actions so the icon flips
        // immediately instead of waiting for the next poll.
        "exec": "$HOME/.local/bin/waybar-nordvpn",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "on-click": "$HOME/.local/bin/nordvpn-menu"
    },

    "custom/wifi-status": {
        // Spinner shown while wifi-menu is in the middle of connecting.
        // wifi-menu drops /tmp/wifi-connecting and sends SIGRTMIN+8 to
        // flip the icon on; removes the file and resignals when nmcli
        // returns. Polled every second so the half-circle frames rotate
        // visibly during the connect window.
        "exec": "$HOME/.local/bin/waybar-wifi-status",
        "return-type": "json",
        "interval": 1,
        "signal": 8
    },

    "network": {
        // Five granular signal strength icons (mdi wifi-strength-0..4
        // from Symbols Nerd Font), with separate glyphs for ethernet
        // and disconnected. Hover for SSID + percent / IP.
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5,
        "on-click": "$HOME/.local/bin/wifi-menu"
    },

    "custom/clock": {
        // macOS-style: "Thu Apr 30 9:28 PM". Goes through `date` (GNU
        // strftime) instead of waybar's built-in clock module because
        // the latter uses C++ chrono, which doesn't support the `-`
        // modifier needed to strip leading zeros from day and hour.
        "exec": "date +'%a %b %-d  %-I:%M %p'",
        "interval": 60,
        "on-click": "$HOME/.local/bin/focus-or-launch org.gnome.Calendar gnome-calendar"
    }
}
