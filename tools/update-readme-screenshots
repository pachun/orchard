#!/usr/bin/env python3
"""Put every screenshot in screenshots/ into the README.

A README is static markdown — GitHub will not loop over a folder for you. So the
loop happens here, and it rewrites the block between the two markers in
README.md. Drop a screenshot in, run this, commit both.

The file's name is its caption, and that is not a shortcut: a screenshot is named
for the theme it shows, so every caption is exactly what you would type into
`set-theme`. A caption that is also a command beats a caption that is a label.
Which means a screenshot named for something that isn't a theme is a mistake, and
this says so rather than quietly captioning it.
"""
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SCREENSHOTS = REPO / "screenshots"
README = REPO / "README.md"
THEMES = REPO / "configuration/desktop/themes/config/orchard-themes"

START = "<!-- screenshots -->"
END = "<!-- /screenshots -->"

COLUMNS = 2


def gallery(shots):
    rows = [shots[i:i + COLUMNS] for i in range(0, len(shots), COLUMNS)]
    lines = ["<table>"]
    for row in rows:
        lines.append("  <tr>")
        for shot in row:
            lines.append(
                f'    <td width="50%"><img src="screenshots/{shot.name}" '
                f'alt="{shot.stem}" width="100%"></td>'
            )
        lines.append("  </tr>")
        lines.append("  <tr>")
        for shot in row:
            lines.append(f'    <td align="center"><code>{shot.stem}</code></td>')
        lines.append("  </tr>")
    lines.append("</table>")
    return "\n".join(lines)


def main():
    shots = sorted(SCREENSHOTS.glob("*.png"))
    if not shots:
        sys.exit(f"no screenshots in {SCREENSHOTS}")

    strays = [s.stem for s in shots if not (THEMES / s.stem).is_dir()]
    if strays:
        sys.exit(
            "these screenshots aren't named for a theme, so they'd caption as "
            f"nothing you could type: {', '.join(strays)}"
        )

    readme = README.read_text()
    if START not in readme or END not in readme:
        sys.exit(f"README.md has no {START} … {END} block to fill in")

    before = readme.split(START)[0]
    after = readme.split(END)[1]
    README.write_text(f"{before}{START}\n{gallery(shots)}\n{END}{after}")

    print(f"  {len(shots)} screenshots into README.md")
    for shot in shots:
        size = shot.stat().st_size // 1024
        print(f"    {shot.stem:<24} {size:>5}KB")


if __name__ == "__main__":
    main()
