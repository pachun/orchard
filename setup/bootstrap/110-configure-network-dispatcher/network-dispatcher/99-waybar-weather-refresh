#!/bin/bash
# NetworkManager dispatcher hook. On any interface coming up (wifi
# reconnect after sleep, fresh boot, etc.) signal waybar to re-fetch
# its weather module. Without this, waybar would happily sit on
# cached/stale weather for up to 10 minutes after wifi recovers.
#
# `signal: 9` in the waybar custom/weather module config maps to
# SIGRTMIN+9. pkill -RTMIN+9 finds and signals the running waybar.
# (Originally 8, moved to 9 to avoid colliding with wifi-status's
# spinner signal — see custom/weather config comment for context.)
case "$2" in
    up|connectivity-change)
        pkill -RTMIN+9 -x waybar
        ;;
esac
