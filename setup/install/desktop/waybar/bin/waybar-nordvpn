#!/bin/sh
# JSON status for waybar's custom/nordvpn module. Shows the shield only
# when actually connected — when disconnected, returns empty so the
# module hides from the bar (less visual noise; absence of a VPN
# indicator means no VPN). Polled every 10s plus a SIGRTMIN+9 nudge
# from nordvpn-menu after explicit actions.
set -eu

command -v nordvpn >/dev/null 2>&1 || exit 0

status=$(nordvpn status 2>/dev/null || true)

if printf '%s' "$status" | grep -q '^Status: Connected'; then
    country=$(printf '%s' "$status" | awk -F': ' '/^Country:/ {print $2}')
    city=$(printf '%s' "$status" | awk -F': ' '/^City:/ {print $2}')
    printf '{"text":"","tooltip":"NordVPN: %s, %s","class":"connected"}\n' "$city" "$country"
else
    printf '{"text":"","tooltip":""}\n'
fi
