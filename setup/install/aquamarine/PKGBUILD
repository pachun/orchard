# Custom PKGBUILD for an orchard-local build of aquamarine that includes
# PR #289 (https://github.com/hyprwm/aquamarine/pull/289) — the fix for
# render device fallback on Apple Silicon. Until that PR merges and ships
# in an upstream release, this build replaces the broken upstream one and
# is held in place by an IgnorePkg entry in /etc/pacman.conf.
#
# Version is suffixed `.orchard1` so it sorts higher than upstream 0.11.0
# (defense in depth alongside IgnorePkg) and is easy to detect with grep.

pkgname=aquamarine
pkgver=0.11.0.orchard1
_upstreamtag=v0.11.0
pkgrel=1
pkgdesc='A very light Linux rendering backend library (orchard build, PR #289 applied)'
arch=('x86_64' 'aarch64')
url='https://github.com/hyprwm/aquamarine'
license=('BSD-3-Clause')
depends=(
    'gcc-libs'
    'glibc'
    'hyprutils'
    'libhyprutils.so'
    'libdrm'
    'libinput'
    'seatd'
    'libseat.so'
    'pixman'
    'systemd-libs'
    'libudev.so'
    'wayland'
)
makedepends=(
    'cmake'
    'ninja'
    'git'
    'hyprwayland-scanner'
    'wayland-protocols'
)
provides=('libaquamarine.so')
source=(
    "git+$url.git#tag=$_upstreamtag"
    'pr-289.patch'
)
sha256sums=(
    'SKIP'
    'SKIP'
)

prepare() {
    cd "$srcdir/$pkgname"
    patch -p1 < "$srcdir/pr-289.patch"
}

build() {
    cd "$srcdir/$pkgname"
    cmake -G Ninja -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    cd "$srcdir/$pkgname"
    DESTDIR="$pkgdir" cmake --install build
}
