#!/usr/bin/env bash
# Guided setup for gcalcli (Google Calendar CLI).
#
# gcalcli needs an OAuth client created in your own Google Cloud
# project — Google removed the bundled credentials some years back. The
# steps below walk through the Console clicks, then `gcalcli init`
# handles the actual OAuth dance.
#
# Idempotent: if ~/.gcalcli_oauth already exists, the script asks
# whether to re-init or bail.
set -euo pipefail

# Nothing in configure installs gcalcli — this connection is its only
# home — so install it (an AUR package) if it isn't here yet.
if ! command -v gcalcli >/dev/null 2>&1; then
    yay -S --needed --noconfirm gcalcli
fi

if [ -f "$HOME/.gcalcli_oauth" ]; then
    printf "gcalcli is already initialized (~/.gcalcli_oauth exists).\n"
    printf "Re-run setup anyway? [y/N] "
    read -r answer
    case "$answer" in
        [yY]*) ;;
        *) echo "Skipping."; exit 0 ;;
    esac
fi

cat <<'EOF'

──────────────────────────────────────────────────────────────────────
gcalcli OAuth setup
──────────────────────────────────────────────────────────────────────

You'll create a Google Cloud OAuth client (one-time, ~3 minutes), then
paste the Client ID / Secret into gcalcli's prompts. Detailed walkthrough
below — press Enter between steps to advance.

EOF
read -r _

cat <<'EOF'
Step 1: Create / select a Google Cloud project
  Open: https://console.cloud.google.com/projectcreate
  - Pick any project name (e.g. "personal-tools")
  - Create, then make sure it's selected in the top-left dropdown

Press Enter when the project is selected.
EOF
xdg-open "https://console.cloud.google.com/projectcreate" >/dev/null 2>&1 &
read -r _

cat <<'EOF'
Step 2: Enable the Google Calendar API
  Open: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
  - Click "Enable"
  - Wait ~30s for it to propagate

Press Enter when the API shows as enabled.
EOF
xdg-open "https://console.cloud.google.com/apis/library/calendar-json.googleapis.com" >/dev/null 2>&1 &
read -r _

cat <<'EOF'
Step 3: Configure the OAuth consent screen (one-time per project)
  Open: https://console.cloud.google.com/apis/credentials/consent
  - User type: External
  - App name: anything (e.g. "gcalcli")
  - Add yourself as a Test user under "Audience" — otherwise Google
    blocks the auth flow with "verification required"

Press Enter when the consent screen is configured.
EOF
xdg-open "https://console.cloud.google.com/apis/credentials/consent" >/dev/null 2>&1 &
read -r _

cat <<'EOF'
Step 4: Create the OAuth Client ID
  Open: https://console.cloud.google.com/apis/credentials
  - "+ Create Credentials" → "OAuth client ID"
  - Application type: Desktop app
  - Click Create
  - Copy the Client ID and Client Secret from the dialog (or the
    pencil icon next to the new client) — you'll paste them next.

Press Enter when you have both values copied.
EOF
xdg-open "https://console.cloud.google.com/apis/credentials" >/dev/null 2>&1 &
read -r _

cat <<'EOF'
Step 5: Run gcalcli init
  gcalcli will prompt for the Client ID, Client Secret, then open a
  browser for Google's consent flow. After approving, paste the
  resulting code back into gcalcli (or it may auto-handle via local
  redirect).

EOF
exec gcalcli init
