#!/usr/bin/env bash
# Guided post-install account hookups — anything that needs you to log in
# or paste credentials, so it doesn't belong in the unattended configure
# flow. Each script under connections/ is standalone and idempotent.
#
#   ./connect            list what's available
#   ./connect tailscale  run one
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "$#" -gt 0 ]; then
  target="$HERE/connections/$1"
  [ -x "$target" ] || { echo "No such connection: $1" >&2; exit 1; }
  exec "$target"
fi

cat <<EOF
──────────────────────────────────────────────────────────────────────
Available connections (run ./connect <name>):
──────────────────────────────────────────────────────────────────────

EOF

for script in "$HERE/connections/"*; do
    [ -f "$script" ] || continue
    name="$(basename "$script")"
    desc="$(awk '/^# / { sub(/^# /, ""); print; exit } !/^#/ { exit }' "$script")"
    printf "  %-20s — %s\n" "$name" "$desc"
done
